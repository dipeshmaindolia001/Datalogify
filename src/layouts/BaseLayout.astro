---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  articleDate?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'Learn Data Analytics by doing — Python, SQL, Excel, EDA, Statistics, and Interview Prep with hands-on, no-fluff lessons.',
  ogImage = '/favicon.svg',
  canonicalUrl,
  articleDate,
  jsonLd,
} = Astro.props;

const siteTitle = title ? `${title} | Datalogify` : 'Datalogify — Learn Data Analytics by Doing';
const canonical = canonicalUrl || Astro.url.href;

const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Datalogify" />
    <meta property="og:locale" content="en_US" />
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@datalogify" />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="author" content="Datalogify" />
    <meta name="publisher" content="Datalogify" />
    <link rel="alternate" type="application/rss+xml" title="Datalogify RSS" href="/rss.xml" />

    <!-- Google Analytics (GA4) -->
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${gaId}');
        `} />
      </>
    )}

    <!-- JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Named slot for extra head content from child layouts -->
    <slot name="head" />

    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-800 antialiased">
    <Header />
    <MobileNav />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Copy Button Script (for all code blocks) -->
    <script>
      function initCopyButtons() {
        document.querySelectorAll('pre:not(.output-block)').forEach((block) => {
          if (block.querySelector('.copy-button')) return;

          const button = document.createElement('button');
          button.className = 'copy-button';
          button.textContent = 'Copy';
          button.addEventListener('click', async () => {
            const code = block.querySelector('code');
            if (code) {
              await navigator.clipboard.writeText(code.textContent || '');
              button.textContent = 'Copied!';
              button.classList.add('copied');
              setTimeout(() => {
                button.textContent = 'Copy';
                button.classList.remove('copied');
              }, 2000);
            }
          });

          block.style.position = 'relative';
          block.appendChild(button);
        });
      }

      // Run on initial load
      initCopyButtons();

      // Re-run after view transitions
      document.addEventListener('astro:page-load', initCopyButtons);
    </script>
  </body>
</html>
