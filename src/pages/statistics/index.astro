    { name: 'Descriptive Statistics', desc: 'Mean, median, mode, std dev — and when each matters' },
    { name: 'Probability Basics', desc: 'Just enough probability for analytics work' },
    { name: 'Normal Distribution', desc: 'The bell curve and why it shows up everywhere' },
    { name: 'Hypothesis Testing', desc: 'p-values, confidence intervals, significance' },
    { name: 'A/B Testing', desc: 'Design and analyze experiments like a pro' },
    { name: 'Regression Basics', desc: 'Predict outcomes and understand relationships' },
  ]}
  prevPhase={{ name: 'Phase 4: EDA', link: '/eda/' }}
  nextPhase={{ name: 'Phase 6: Projects', link: '/projects/' }}
/>
