---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sqlChallenges } from '../../../data/sql-challenges';

const tier1Challenges = sqlChallenges.filter(c => c.section === 'tier1');
const tier2Challenges = sqlChallenges.filter(c => c.section === 'tier2');
const tier3Challenges = sqlChallenges.filter(c => c.section === 'tier3');
const tier4Challenges = sqlChallenges.filter(c => c.section === 'tier4');
const tier5Challenges = sqlChallenges.filter(c => c.section === 'tier5');
const tier6Challenges = sqlChallenges.filter(c => c.section === 'tier6');
const tier7Challenges = sqlChallenges.filter(c => c.section === 'tier7');
const tier8Challenges = sqlChallenges.filter(c => c.section === 'tier8');
const tier9Challenges = sqlChallenges.filter(c => c.section === 'tier9');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Interactive SQL Coding Practice',
  description: 'Practice SQL coding directly in your browser. Solve hands-on SQLite exercises, run queries, and check answers instantly with client-side WebAssembly.',
  provider: { '@type': 'Organization', name: 'Datalogify' },
  numberOfLessons: sqlChallenges.length,
};
---

<BaseLayout
  title="Interactive SQL Practice Arena | Datalogify"
  description="Practice SQL queries interactively. Write SQLite queries directly in the browser and verify solutions with real-time test cases. Track your progress now!"
  jsonLd={jsonLd}
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8 lg:py-12">
    <!-- Header banner -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 px-6 py-12 sm:px-12 sm:py-16 shadow-2xl mb-12 animate-fade-in">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,#312e81,transparent)] opacity-40"></div>
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl"></div>
      <div class="absolute right-12 bottom-12 text-7xl opacity-10 select-none animate-pulse">💻</div>
      
      <div class="relative z-10 max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 mb-4 uppercase tracking-wider">
          ⚡ Interactive Arena
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight min-h-[72px] sm:min-h-[96px] lg:min-h-[120px]">
          Practice <span id="typed-text" class="bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400 bg-clip-text text-transparent">SQL</span><span class="typewriter-cursor text-indigo-400 animate-pulse ml-0.5">|</span> Coding <br/>
          Directly in Your Browser
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          Test your SQL skills with 100 SQLite interactive challenges. Write queries, execute them in-browser, and verify solutions against expected outputs instantly.
        </p>
      </div>
    </div>

    <!-- Main Navigation Tabs (Python vs SQL) -->
    <div class="flex gap-4 border-b border-slate-200 pb-4 mb-8">
      <a 
        href="/practice/"
        class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-slate-50 text-slate-500 border border-slate-100 hover:bg-slate-100 hover:text-slate-700 transition-colors focus:outline-none flex items-center gap-2"
      >
        🐍 Python Practice
      </a>
      <a 
        href="/practice/sql/"
        class="px-5 py-2.5 rounded-xl text-sm font-bold bg-indigo-650 text-white shadow-md shadow-indigo-500/15 focus:outline-none flex items-center gap-2"
      >
        🗃️ SQL Practice
      </a>
    </div>

    <!-- Split Pane Layout: Sidebar + Challenge Cards -->
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Left Side: Sticky Navigation Sidebar -->
      <aside class="w-full lg:w-1/4 shrink-0 lg:sticky lg:top-24 h-fit">
        <div class="bg-white border border-slate-100 rounded-2xl p-4 space-y-1.5 shadow-sm">
          <h3 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest px-3 mb-2">SQL Tracks</h3>
          
          <button 
            data-track-btn="tier1" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🌱 Tier 1 — Fundamentals</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier1">0/20</span>
          </button>

          <button 
            data-track-btn="tier2" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">📊 Tier 2 — Aggregations</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier2">0/20</span>
          </button>

          <button 
            data-track-btn="tier3" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">📆 Tier 3 — Functions</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier3">0/20</span>
          </button>

          <button 
            data-track-btn="tier4" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🔗 Tier 4 — Joins</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier4">0/20</span>
          </button>

          <button 
            data-track-btn="tier5" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🔎 Tier 5 — Subqueries</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier5">0/20</span>
          </button>

          <button 
            data-track-btn="tier6" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🗳️ Tier 6 — Set Operations</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier6">0/20</span>
          </button>

          <button 
            data-track-btn="tier7" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">📈 Tier 7 — Window Fn</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier7">0/20</span>
          </button>

          <button 
            data-track-btn="tier8" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🔁 Tier 8 — CTEs & Recursion</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier8">0/20</span>
          </button>

          <button 
            data-track-btn="tier9" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🧠 Tier 9 — Advanced Patterns</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-tier9">0/20</span>
          </button>
        </div>
      </aside>

      <!-- Right Side: Challenge cards list matching selection -->
      <main class="flex-1 min-w-0">
        <!-- Section: Tier 1 -->
        <div id="track-panel-tier1" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">🌱 Tier 1 — Fundamentals</h2>
            <p class="text-xs text-slate-450 mt-1">Master basic SELECT statements, WHERE filters, ranges, NULL checks, sorting, and simple CASE logic</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {tier1Challenges.map((challenge) => (
              <a
                href={`/practice/sql/${challenge.slug}/`}
                class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-bold text-slate-355">#{challenge.order}</span>
                      <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-650 transition-colors truncate">
                        {challenge.title}
                      </h3>
                    </div>
                    <p class="text-xs text-slate-455 line-clamp-2">{challenge.prompt}</p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-50 text-emerald-600 border border-emerald-100">
                    {challenge.difficulty}
                  </span>
                  <span 
                    data-challenge-status={challenge.id}
                    class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                  >
                    Not Started
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Section: Tier 2 -->
        <div id="track-panel-tier2" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">📊 Tier 2 — Aggregation & Grouping</h2>
            <p class="text-xs text-slate-450 mt-1">Master COUNT, SUM, AVG, MIN/MAX, GROUP BY, HAVING, and conditional aggregation ratios</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {tier2Challenges.map((challenge) => (
              <a
                href={`/practice/sql/${challenge.slug}/`}
                class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-bold text-slate-355">#{challenge.order}</span>
                      <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-650 transition-colors truncate">
                        {challenge.title}
                      </h3>
                    </div>
                    <p class="text-xs text-slate-455 line-clamp-2">{challenge.prompt}</p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-50 text-emerald-600 border border-emerald-100">
                    {challenge.difficulty}
                  </span>
                  <span 
                    data-challenge-status={challenge.id}
                    class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                  >
                    Not Started
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Section: Tier 3 -->
        <div id="track-panel-tier3" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">📆 Tier 3 — String, Date & Numeric Functions</h2>
            <p class="text-xs text-slate-455 mt-1">Master UPPER/LOWER, string length, substring extraction, date arithmetic, and rounding logic</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {tier3Challenges.map((challenge) => (
              <a
                href={`/practice/sql/${challenge.slug}/`}
                class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-bold text-slate-355">#{challenge.order}</span>
                      <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-650 transition-colors truncate">
                        {challenge.title}
                      </h3>
                    </div>
                    <p class="text-xs text-slate-455 line-clamp-2">{challenge.prompt}</p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-50 text-emerald-600 border border-emerald-100">
                    {challenge.difficulty}
                  </span>
                  <span 
                    data-challenge-status={challenge.id}
                    class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                  >
                    Not Started
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Section: Tier 4 -->
        <div id="track-panel-tier4" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">🔗 Tier 4 — Joins</h2>
            <p class="text-xs text-slate-455 mt-1">Master inner joins, left joins, self joins, cross joins, multi-table joins, and semi-joins</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {tier4Challenges.map((challenge) => (
              <a
                href={`/practice/sql/${challenge.slug}/`}
