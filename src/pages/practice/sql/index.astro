        <!-- Section: Tier 8 -->
        <div id="track-panel-tier8" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">🔁 Tier 8 — CTEs & Recursion</h2>
            <p class="text-xs text-slate-455 mt-1">Master standard Common Table Expressions (WITH), multiple CTEs, recursive CTEs, and hierarchies</p>
