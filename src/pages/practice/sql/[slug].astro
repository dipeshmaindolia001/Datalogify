---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sqlChallenges } from '../../../data/sql-challenges';

export async function getStaticPaths() {
  return sqlChallenges.map((challenge) => ({
    params: { slug: challenge.slug },
    props: { challenge },
  }));
}

const { challenge } = Astro.props;
---

<BaseLayout
  title={`SQL Practice: ${challenge.title} | Datalogify`}
  description={`Solve the ${challenge.title} database query challenge in SQL. Run query results directly in the browser and verify your solution.`}
>
  <!-- Load Prism Tomorrow theme -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />

  <div class="ide-container flex flex-col lg:flex-row overflow-hidden" data-challenge-id={challenge.id}>
    <!-- Left Panel: SQL Prompt & Schema Details -->
    <div class="description-pane w-full lg:w-1/2 flex flex-col border-b lg:border-b-0 lg:border-r h-1/2 lg:h-full overflow-y-auto p-6 space-y-6">
      <!-- Header section -->
      <div>
        <a href="/practice/sql/" class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-white transition-colors mb-4">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
          Back to SQL Dashboard
        </a>
        <div class="flex items-center gap-3">
          <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            {challenge.title}
          </h1>
          <span class:list={[
            'text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border',
            challenge.difficulty === 'basic' ? 'bg-emerald-950/50 text-emerald-400 border-emerald-800/60' : '',
            challenge.difficulty === 'intermediate' ? 'bg-amber-950/50 text-amber-400 border-amber-800/60' : '',
            challenge.difficulty === 'advanced' ? 'bg-red-950/50 text-red-400 border-red-800/60' : '',
          ]}>
            {challenge.difficulty}
          </span>
        </div>
        <div class="text-[10px] font-mono text-slate-500 mt-1">{challenge.section.toUpperCase()} · {challenge.concept}</div>
      </div>

      <!-- Left panel tabs: Description / Solutions -->
      <div class="desc-tabs flex border-b border-slate-800 text-[11px] font-semibold text-slate-400 -mx-6 px-6 mb-4">
        <button
          id="desc-tab-problem-btn"
          class="px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer"
        >
          Problem
        </button>
        <button
          id="desc-tab-solutions-btn"
          class="px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer flex items-center gap-1.5"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.347.347A3.5 3.5 0 0111.5 18H9a3.5 3.5 0 01-3.5-3.5v-.1a3.5 3.5 0 011.018-2.45z" /></svg>
          Solutions
        </button>
      </div>

      <!-- Problem panel -->
      <div id="desc-panel-problem" class="space-y-6">
        <!-- Problem Prompt -->
        <div class="space-y-4 text-sm text-slate-300 leading-relaxed">
          <p class="whitespace-pre-line">{challenge.prompt}</p>
        </div>

        <!-- Table Schema Structure Card -->
        <div class="pt-4 border-t border-slate-800">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-450 mb-3">Database Schema</h3>
          <div class="space-y-4">
            {challenge.schemaNote.split('\n').map(line => {
              const match = line.trim().match(/^([a-zA-Z_0-9]+)\((.+)\)$/);
              if (!match) return <div class="font-mono text-xs text-indigo-300 bg-[#0b0f19] border border-slate-800/80 rounded-xl p-3">{line}</div>;

              const tableName = match[1];
              const columns = match[2].split(',').map(c => c.trim());

              return (
                <div class="bg-slate-900/40 border border-slate-800/80 rounded-xl overflow-hidden shadow-sm">
                  <!-- Table Header -->
                  <div class="bg-[#0b0f19] border-b border-slate-800/80 px-4 py-2 flex items-center gap-2">
                    <span class="text-xs">🗂️</span>
                    <span class="font-mono text-xs font-bold text-slate-200">{tableName}</span>
                  </div>
                  <!-- Columns List -->
                  <div class="divide-y divide-slate-800/30 font-mono text-xs">
                    {columns.map(col => {
                      const isId = col === 'id' || col.endsWith('_id');
                      const isDate = col.endsWith('date');
                      const isNumeric = col === 'price' || col === 'salary' || col === 'amount' || col === 'quantity' || col === 'minutes_played';
                      
                      let typeTag = 'TEXT';
                      let typeClass = 'bg-slate-800/50 text-slate-400 border-slate-700/30';
                      if (isId) {
                        typeTag = 'INT';
                        typeClass = 'bg-indigo-950/40 text-indigo-300 border-indigo-900/40';
                      } else if (isDate) {
                        typeTag = 'DATE';
                        typeClass = 'bg-amber-950/40 text-amber-300 border-amber-900/40';
                      } else if (isNumeric) {
                        typeTag = 'NUM';
                        typeClass = 'bg-emerald-950/40 text-emerald-300 border-emerald-900/40';
                      }

                      return (
                        <div class="px-4 py-2 flex items-center justify-between hover:bg-slate-800/10">
                          <span class="flex items-center gap-2 text-slate-300">
                            {isId ? (
                              <span class="text-indigo-400 select-none">🔑</span>
                            ) : (
                              <span class="text-slate-500 select-none">🔹</span>
                            )}
                            <span class={isId ? 'font-semibold text-slate-100' : 'text-slate-350'}>{col}</span>
                          </span>
                          <span class={`text-[9px] font-bold px-1.5 py-0.5 rounded border ${typeClass}`}>
                            {typeTag}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Solutions panel (hidden by default) -->
      <div id="desc-panel-solutions" class="hidden space-y-4">
        <div class="flex items-start gap-2 p-3 bg-amber-950/30 border border-amber-800/40 rounded-xl">
          <svg class="w-4 h-4 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          <p class="text-xs text-amber-300/90">Try writing the query yourself first! Use the solutions for validation or comparing approaches.</p>
        </div>
        
        {challenge.solutions && challenge.solutions.length > 0 ? (
          challenge.solutions.map((sol, idx) => (
            <div class="solution-card border border-slate-800 rounded-xl overflow-hidden">
              <button
                class="sol-toggle w-full flex items-center justify-between px-4 py-3 text-left bg-slate-900/80 hover:bg-slate-800/80 transition-colors cursor-pointer"
                data-sol-idx={idx}
              >
                <div>
                  <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">Solution {idx + 1}</span>
                  <div class="text-sm font-semibold text-white mt-0.5">{sol.title}</div>
                  <p class="text-xs text-slate-400 mt-0.5">{sol.explanation}</p>
                </div>
                <svg class="sol-chevron w-4 h-4 text-slate-500 shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <div class="sol-body hidden bg-slate-950">
                <pre class="solution-pre font-mono text-xs p-4 overflow-x-auto text-slate-200 leading-relaxed language-sql">{sol.code}</pre>
                <div class="px-4 pb-3 flex gap-2">
                  <button class="sol-try-btn text-[10px] font-bold text-indigo-400 hover:text-indigo-300 transition-colors cursor-pointer flex items-center gap-1" data-sol-code={sol.code}>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    Load into Editor
                  </button>
                </div>
              </div>
            </div>
          ))
        ) : (
          <div class="solution-card border border-slate-800 rounded-xl overflow-hidden">
            <button
              class="sol-toggle w-full flex items-center justify-between px-4 py-3 text-left bg-slate-900/80 hover:bg-slate-800/80 transition-colors cursor-pointer"
              data-sol-idx="0"
            >
              <div>
                <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">Solution 1</span>
                <div class="text-sm font-semibold text-white mt-0.5">Standard SQL Query</div>
                <p class="text-xs text-slate-400 mt-0.5">Standard query to solve the challenge using fundamental SQL operations.</p>
              </div>
              <svg class="sol-chevron w-4 h-4 text-slate-500 shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </button>
            <div class="sol-body hidden bg-slate-950">
              <pre class="solution-pre font-mono text-xs p-4 overflow-x-auto text-slate-200 leading-relaxed language-sql">{challenge.solution}</pre>
              <div class="px-4 pb-3 flex gap-2">
                <button class="sol-try-btn text-[10px] font-bold text-indigo-400 hover:text-indigo-300 transition-colors cursor-pointer flex items-center gap-1" data-sol-code={challenge.solution}>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  Load into Editor
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Right Panel: Code Editor, Action toolbar, Terminal outputs -->
    <div class="editor-pane w-full lg:w-1/2 flex flex-col h-1/2 lg:h-full overflow-hidden">
      <!-- Editor Header bar -->
      <div class="editor-header flex items-center justify-between px-6 py-3 border-b">
        <span class="text-xs font-semibold flex items-center gap-1.5 text-slate-400">
          <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
          SQLite 3.x Sandbox (Interactive Query Editor)
        </span>
        <button 
          id="btn-reset-query"
          class="text-xs font-semibold text-slate-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer"
          data-starter-code={challenge.starterCode}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.5" />
          </svg>
          Reset Query
        </button>
      </div>

      <!-- CodeJar SQL Syntax Highlight Editor -->
      <div class="flex-1 relative overflow-hidden flex min-h-[150px]">
        <!-- Gutter line numbers -->
        <div id="sql-gutter" class="gutter-lines w-12 border-r flex flex-col items-end pr-3 py-4 select-none font-mono text-xs leading-6 overflow-hidden">
          <span>1</span>
        </div>
        <!-- Editor div -->
        <div
          id="sql-editor"
          class="language-sql flex-1 h-full py-4 px-4 font-mono text-xs leading-6 focus:outline-none overflow-y-auto whitespace-pre tab-size-4"
          spellcheck="false"
        ></div>
      </div>

      <!-- Action toolbar & sandbox console -->
      <div class="console-panel flex flex-col shrink-0">
        <!-- Control buttons -->
        <div class="console-header flex items-center justify-between px-6 py-3 border-b">
          <div class="flex items-center gap-2">
            <!-- SQLite Loader label -->
            <span id="sqlite-status" class="text-xs text-slate-400 flex items-center gap-2 font-medium">
              <svg class="w-4 h-4 text-indigo-500 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Starting SQLite Wasm...
            </span>
          </div>

          <div class="flex items-center gap-3">
            <button
              id="btn-run-query"
              class="px-4 py-1.5 rounded-lg text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-100 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              disabled
            >
              Run Query
            </button>
            <button
              id="btn-submit-query"
              class="px-4 py-1.5 rounded-lg text-xs font-bold bg-indigo-650 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-500/20 transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              disabled
            >
              Submit Query
            </button>
          </div>
        </div>

        <!-- Terminal tabs navigation -->
        <div class="console-tabs flex border-b text-[11px] font-semibold text-slate-400">
          <button 
            id="tab-tests-btn"
            class="px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer"
          >
            Test Cases
          </button>
          <button 
            id="tab-results-btn"
            class="px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer"
          >
            Query Results
          </button>
          <button 
            id="tab-errors-btn"
            class="px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer"
          >
            Compiler Logs
          </button>
        </div>

        <!-- Test cases and output terminal body -->
        <div class="console-body p-5 h-48 overflow-y-auto font-mono text-xs leading-relaxed">
          <!-- Test cases results panel -->
          <div id="panel-tests" class="space-y-3">
            <div class="text-slate-500 font-mono">Click "Run Query" or "Submit Query" to verify correctness.</div>
          </div>
          <!-- Query results table panel -->
          <div id="panel-results" class="hidden overflow-x-auto text-slate-300">
            No query results loaded yet.
          </div>
          <!-- Errors tab panel -->
          <div id="panel-errors" class="hidden whitespace-pre overflow-x-auto text-red-400">
            No compiler logs. Database queries running cleanly.
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- Load SQLite and Prism SQL assets -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js"></script>

<!-- Server to client variables bridge -->
<script is:inline define:vars={{ challenge }}>
  window.challengeData = challenge;
</script>

<script>
  import { CodeJar } from 'codejar';

  const challenge = (window as any).challengeData;
  let SQLLib: any = null;
  let dbInstance: any = null;
  let jar: any = null;

  const FRAGMENTS: Record<string, string> = {
    A:`
      CREATE TABLE sessions(session_id INTEGER PRIMARY KEY, user_id INTEGER, app_name TEXT, minutes_played INTEGER, session_date TEXT);
      INSERT INTO sessions VALUES
      (1,101,'BeatWave',45,'2026-06-02'),
      (2,102,'BeatWave',12,'2026-06-03'),
      (3,101,'ClipStream',60,'2026-06-05'),
      (4,103,'BeatWave',5,'2026-06-06'),
      (5,104,NULL,25,'2026-06-07'),
      (6,102,'ClipStream',80,'2026-06-08'),
      (7,105,'BeatWave',33,'2026-06-10'),
      (8,101,'BeatWave',20,'2026-06-11'),
      (9,103,'ClipStream',50,'2026-06-15'),
      (10,106,'BeatWave',15,'2026-07-01');
    `,
    B:`
      CREATE TABLE users(user_id INTEGER PRIMARY KEY, name TEXT, email TEXT, signup_date TEXT, country TEXT);
      INSERT INTO users VALUES
      (101,'Aarav','aarav.k@mailbox.com','2026-01-15','India'),
      (102,'Diya','diya102@streammail.com','2026-02-20','India'),
      (103,'Kabir','kabir_c@mailbox.com','2026-03-05','USA'),
      (104,'Isha','isha.p@quickmail.com','2026-04-12','UK'),
      (105,'Neel','neel99@streammail.com','2026-05-18','Canada'),
      (106,'Riya','riya.b@mailbox.com','2026-06-01','USA');
    `,
    C:`
      CREATE TABLE orders(order_id INTEGER PRIMARY KEY, customer_id INTEGER, product_id INTEGER, quantity INTEGER, order_date TEXT, status TEXT);
      INSERT INTO orders VALUES
      (1,1,1,2,'2026-06-01','Completed'),
      (2,2,2,1,'2026-06-02','Completed'),
      (3,1,3,1,'2026-06-03','Pending'),
      (4,3,1,3,'2026-06-04','Completed'),
      (5,2,3,2,'2026-06-05','Cancelled'),
      (6,4,2,1,'2026-06-06','Completed'),
      (7,1,4,1,'2026-06-07','Completed');
    `,
    D:`
      CREATE TABLE customers(customer_id INTEGER PRIMARY KEY, name TEXT, city TEXT, signup_date TEXT);
      INSERT INTO customers VALUES
      (1,'Anaya','Mumbai','2026-01-10'),
      (2,'Dev','Delhi','2026-02-14'),
      (3,'Sana','New York','2026-03-20'),
      (4,'Rohan','London','2026-04-05'),
      (5,'Tara','Mumbai','2026-05-12');
    `,
    E:`
      CREATE TABLE products(product_id INTEGER PRIMARY KEY, product_name TEXT, category TEXT, price REAL);
      INSERT INTO products VALUES
      (1,'Wireless Mouse','Electronics',799.00),
      (2,'Mechanical Keyboard','Electronics',2999.00),
      (3,'USB-C Hub','Electronics',1499.00),
      (4,'Office Chair','Furniture',4999.00),
      (5,'Notebook','Stationery',150.00);
    `,
    F:`
      CREATE TABLE employees(emp_id INTEGER PRIMARY KEY, name TEXT, dept TEXT, manager_id INTEGER, salary INTEGER, hire_date TEXT);
      INSERT INTO employees VALUES
      (1,'Meera','Engineering',NULL,95000,'2024-03-15'),
      (2,'Arjun','Engineering',1,88000,'2024-06-10'),
      (3,'Priya','Engineering',1,88000,'2024-09-01'),
      (4,'Rohan','Sales',2,72000,'2025-01-15'),
      (5,'Tara','Sales',2,68000,'2025-04-10'),
      (6,'Vikram','Marketing',3,60000,'2025-08-01');
    `,
    G:`
      CREATE TABLE transactions(txn_id INTEGER PRIMARY KEY, account_id INTEGER, amount REAL, txn_date TEXT, txn_type TEXT);
      INSERT INTO transactions VALUES
      (1,1001,5000.00,'2026-06-01','Deposit'),
      (2,1002,150.00,'2026-06-02','Withdrawal'),
      (3,1001,200.00,'2026-06-03','Withdrawal'),
      (4,1003,1200.00,'2026-06-04','Deposit'),
      (5,1002,300.00,'2026-06-05','Deposit');
    `,
    H:`
      CREATE TABLE daily_metrics(metric_date TEXT PRIMARY KEY, revenue REAL, active_users INTEGER);
      INSERT INTO daily_metrics VALUES
      ('2026-06-01',15000.00,120),
      ('2026-06-02',18000.00,135),
      ('2026-06-03',12000.00,110),
      ('2026-06-04',22000.00,150),
      ('2026-06-05',25000.00,165);
    `
  };

  function resolveSetup(setup: string): string {
    const parts = setup.split('\n');
    let combinedSql = '';
    parts.forEach(part => {
      const key = part.trim();
      if (FRAGMENTS[key]) {
        combinedSql += FRAGMENTS[key] + '\n';
      } else {
        // Fallback for custom table schema definition (e.g. Q96, Q97)
        combinedSql += key + '\n';
      }
    });
    return combinedSql;
  }

  // Initialize SQLite Wasm library
  async function initSQLite() {
    const statusLabel = document.getElementById('sqlite-status');
    const runBtn = document.getElementById('btn-run-query');
    const submitBtn = document.getElementById('btn-submit-query');

    try {
      if (typeof (window as any).initSqlJs === 'undefined') {
        throw new Error('SQLite library script failed to load from CDN.');
      }
      
      SQLLib = await (window as any).initSqlJs({ locateFile: (file: string) => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/${file}` });
      
      // Warm up initial SQLite database instance
      dbInstance = new SQLLib.Database();
      const setupSql = resolveSetup(challenge.setup);
      if (setupSql.trim()) {
        dbInstance.exec(setupSql);
      }

      if (statusLabel) {
        statusLabel.innerHTML = `
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Ready
        `;
      }
      if (runBtn) runBtn.removeAttribute('disabled');
      if (submitBtn) submitBtn.removeAttribute('disabled');
    } catch (err: any) {
      console.error(err);
      if (statusLabel) {
        statusLabel.innerHTML = `
          <span class="w-2 h-2 rounded-full bg-red-500"></span>
          Wasm error
        `;
      }
    }
  }

  // CodeJar editor init
  function initEditor() {
    const editorEl = document.getElementById('sql-editor');
    if (!editorEl) return;

    const highlight = (editor: HTMLElement) => {
      const code = editor.textContent || '';
      if ((window as any).Prism) {
        editor.innerHTML = (window as any).Prism.highlight(code, (window as any).Prism.languages.sql, 'sql');
      }
    };

    jar = CodeJar(editorEl, highlight);
    jar.updateCode(challenge.starterCode);
    
    jar.onUpdate((code: string) => {
      updateLineNumbers(code);
    });

    updateLineNumbers(challenge.starterCode);
  }

  function updateLineNumbers(code: string) {
    const gutter = document.getElementById('sql-gutter');
    if (!gutter) return;

    const lines = code.split('\n').length;
    let numbersHtml = '';
    for (let i = 1; i <= lines; i++) {
      numbersHtml += `<span>${i}</span>`;
    }
    gutter.innerHTML = numbersHtml;
  }

  // Left panel: Description / Solutions tab toggling
  function selectDescTab(tabName: string) {
    const problemBtn = document.getElementById('desc-tab-problem-btn');
    const solutionsBtn = document.getElementById('desc-tab-solutions-btn');
    const problemPanel = document.getElementById('desc-panel-problem');
    const solutionsPanel = document.getElementById('desc-panel-solutions');

    const activeClass = 'px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer flex items-center gap-1.5';
    const inactiveClass = 'px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer flex items-center gap-1.5';
    const activeClassSimple = 'px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer';
    const inactiveClassSimple = 'px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer';

    if (tabName === 'problem') {
      if (problemBtn) problemBtn.className = activeClassSimple;
      if (solutionsBtn) solutionsBtn.className = inactiveClass;
      if (problemPanel) problemPanel.classList.remove('hidden');
      if (solutionsPanel) solutionsPanel.classList.add('hidden');
    } else {
      if (problemBtn) problemBtn.className = inactiveClassSimple;
      if (solutionsBtn) solutionsBtn.className = activeClass;
      if (problemPanel) problemPanel.classList.add('hidden');
      if (solutionsPanel) solutionsPanel.classList.remove('hidden');
    }
  }

  // Toggling Terminal Panels
  function selectConsoleTab(tabName: string) {
    const tabs = ['tests', 'results', 'errors'];
    tabs.forEach(t => {
      const btn = document.getElementById(`tab-${t}-btn`);
      const panel = document.getElementById(`panel-${t}`);
      if (btn && panel) {
        if (t === tabName) {
          btn.className = 'px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer';
          panel.classList.remove('hidden');
        } else {
          btn.className = 'px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer';
          panel.classList.add('hidden');
        }
      }
    });
  }

  function execToRows(db: any, query: string) {
    const res = db.exec(query);
    if (res.length === 0) return { columns: [], rows: [] };
    return { columns: res[0].columns, rows: res[0].values };
  }

  function renderTable(columns: string[], rows: any[][]) {
    const panelResults = document.getElementById('panel-results');
    if (!panelResults) return;

    if (columns.length === 0) {
      panelResults.innerHTML = '<div class="text-slate-500">Query executed successfully. Zero rows returned.</div>';
      return;
    }

    let html = `<div class="text-[10px] text-slate-500 mb-2">${rows.length} row${rows.length !== 1 ? 's' : ''} returned</div>`;
    html += '<table class="w-full border-collapse text-left text-slate-350 min-w-max">';
    html += '<thead><tr class="border-b border-slate-800">';
    columns.forEach(c => html += `<th class="pb-2 font-bold text-indigo-400 px-3">${escapeHtml(c)}</th>`);
    html += '</tr></thead><tbody>';
    rows.forEach(r => {
      html += '<tr class="border-b border-slate-800/40 hover:bg-slate-800/10">' + r.map(v => `<td class="py-2 px-3">${v === null ? '<span class="text-slate-655">NULL</span>' : escapeHtml(String(v))}</td>`).join('') + '</tr>';
    });
    html += '</tbody></table>';
    panelResults.innerHTML = html;
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function rowsSignature(columns: string[], rows: any[][], ordered: boolean) {
    let r = rows.map(row => row.map(v => v === null ? '∅' : String(v)).join('\u0001'));
    if (!ordered) r = r.slice().sort();
    return columns.join('\u0002') + '||' + r.join('\u0003');
  }

  async function executeSQLQuery(submitMode = false) {
    const testsPanel = document.getElementById('panel-tests');
    const resultsPanel = document.getElementById('panel-results');
    const errorsPanel = document.getElementById('panel-errors');
    
    if (!jar || !dbInstance || !testsPanel || !resultsPanel || !errorsPanel) return;

    const userQuery = jar.toString().trim();
    if (!userQuery) {
      testsPanel.innerHTML = '<div class="text-red-400 font-mono">Write a SQL query first.</div>';
      selectConsoleTab('tests');
      return;
    }

    testsPanel.innerHTML = '<div class="text-indigo-400 animate-pulse">Running SQLite compiler...</div>';
    resultsPanel.innerHTML = '';
    errorsPanel.innerHTML = '';

    // Mark as in-progress
    const progressList = JSON.parse(localStorage.getItem('datalogify_in_progress_sql_challenges') || '[]');
    if (!progressList.includes(challenge.id)) {
      progressList.push(challenge.id);
      localStorage.setItem('datalogify_in_progress_sql_challenges', JSON.stringify(progressList));
    }

    try {
      // Execute user query
      const userRes = execToRows(dbInstance, userQuery);
      renderTable(userRes.columns, userRes.rows);

      // Execute solution query to verify
      const solutionRes = execToRows(dbInstance, challenge.solution);

      const userSig = rowsSignature(userRes.columns, userRes.rows, challenge.orderMatters);
      const solSig = rowsSignature(solutionRes.columns, solutionRes.rows, challenge.orderMatters);

      if (userSig === solSig) {
        testsPanel.innerHTML = `
          <div class="border-l-2 border-emerald-500 pl-3 py-1 space-y-1">
            <div class="text-emerald-400 font-bold">Passed ✅ — Solution Match</div>
            <div class="text-[10px] text-slate-500">Correct column signatures, row counts, and sorting output returned.</div>
          </div>
        `;

        if (submitMode) {
          // Save solved status
          const solvedList = JSON.parse(localStorage.getItem('datalogify_solved_sql_challenges') || '[]');
          if (!solvedList.includes(challenge.id)) {
            solvedList.push(challenge.id);
            localStorage.setItem('datalogify_solved_sql_challenges', JSON.stringify(solvedList));
          }

          testsPanel.innerHTML += `
            <div class="mt-4 p-3 bg-emerald-950/40 border border-emerald-800/40 rounded-xl text-emerald-400 font-semibold text-center animate-bounce">
              Congratulations! Your SQL query is fully correct. Submission successful! 🚀
            </div>
          `;
        }
      } else {
        testsPanel.innerHTML = `
          <div class="border-l-2 border-red-500 pl-3 py-1 space-y-1">
            <div class="text-red-400 font-bold">Incorrect Output ❌ — Table Mismatch</div>
            <div class="text-[10px] text-slate-400">Expected: <span class="text-emerald-400">${solutionRes.rows.length} row(s)</span> | Got: <span class="text-red-400">${userRes.rows.length} row(s)</span></div>
            <div class="text-[10px] text-slate-500">${challenge.orderMatters ? 'Note: Row order matters for this query.' : 'Row order does not matter.'}</div>
          </div>
        `;
      }
      selectConsoleTab('tests');
    } catch (err: any) {
      errorsPanel.textContent = err.message;
      testsPanel.innerHTML = `
        <div class="border-l-2 border-red-500 pl-3 py-1">
          <div class="text-red-400 font-bold">SQLite Parser Error ⚠️</div>
          <div class="text-[10px] text-slate-550">Check Compiler Logs for syntax details.</div>
        </div>
      `;
      selectConsoleTab('errors');
    }
  }

  // Page mount setups
  document.addEventListener('astro:page-load', () => {
    initEditor();

    // Reset button click
    const resetBtn = document.getElementById('btn-reset-query');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        const starter = resetBtn.getAttribute('data-starter-code');
        if (jar && starter) {
          jar.updateCode(starter);
          updateLineNumbers(starter);
        }
      });
    }

    // Run buttons click
    const runBtn = document.getElementById('btn-run-query');
    if (runBtn) runBtn.addEventListener('click', () => executeSQLQuery(false));

    const submitBtn = document.getElementById('btn-submit-query');
    if (submitBtn) submitBtn.addEventListener('click', () => executeSQLQuery(true));

    // Console tabs clicks
    const tabs = ['tests', 'results', 'errors'];
    tabs.forEach(t => {
      const btn = document.getElementById(`tab-${t}-btn`);
      if (btn) {
        btn.addEventListener('click', () => selectConsoleTab(t));
      }
    });

    // Left panel (Problem / Solutions) tab clicks
    const problemTabBtn = document.getElementById('desc-tab-problem-btn');
    const solutionsTabBtn = document.getElementById('desc-tab-solutions-btn');
    if (problemTabBtn) {
      problemTabBtn.addEventListener('click', () => selectDescTab('problem'));
    }
    if (solutionsTabBtn) {
      solutionsTabBtn.addEventListener('click', () => selectDescTab('solutions'));
    }

    // Solution accordion toggles
    document.querySelectorAll('.sol-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.getAttribute('data-sol-idx');
        const body = btn.nextElementSibling as HTMLElement | null;
        const chevron = btn.querySelector('.sol-chevron') as HTMLElement | null;
        if (body) {
          body.classList.toggle('hidden');
          if (chevron) {
            chevron.style.transform = body.classList.contains('hidden') ? '' : 'rotate(180deg)';
          }
          // Syntax highlight the solution code
          if (!body.classList.contains('hidden')) {
            const pre = body.querySelector('.solution-pre') as HTMLElement | null;
            if (pre && (window as any).Prism) {
              const raw = pre.textContent || '';
              pre.innerHTML = (window as any).Prism.highlight(raw, (window as any).Prism.languages.sql, 'sql');
            }
          }
        }
      });
    });

    // "Load into Editor" buttons
    document.querySelectorAll('.sol-try-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-sol-code') || '';
        if (jar && code) {
          jar.updateCode(code);
          updateLineNumbers(code);
          // Switch to Problem tab so user can run it
          selectDescTab('problem');
          // Scroll to top of editor
          document.getElementById('sql-editor')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Start SQLite compilation
    initSQLite();
  });
</script>

