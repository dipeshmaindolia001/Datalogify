---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { challenges } from '../../data/practice-challenges';

export async function getStaticPaths() {
  return challenges.map((challenge) => ({
    params: { slug: challenge.slug },
    props: { challenge },
  }));
}

const { challenge } = Astro.props;
---

<BaseLayout
  title={`Practice: ${challenge.title} | Datalogify`}
  description={`Solve the ${challenge.title} challenge in Python. Run test cases directly in the browser and verify your solution.`}
>
  <!-- Load Prism dark theme styles -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />

  <div class="ide-container flex flex-col lg:flex-row overflow-hidden" data-challenge-id={challenge.id}>
    <!-- Left panel: Challenge description -->
    <div class="description-pane w-full lg:w-1/2 flex flex-col border-b lg:border-b-0 lg:border-r h-1/2 lg:h-full overflow-y-auto p-6 space-y-6">
      <!-- Back and title -->
      <div>
        <a href="/practice/" class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-white transition-colors mb-4">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Challenges
        </a>
        <div class="flex items-center gap-3">
          <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            {challenge.title}
          </h1>
          <span class:list={[
            'text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded border',
            challenge.difficulty === 'basic' ? 'bg-emerald-950/50 text-emerald-400 border-emerald-800/60' : '',
            challenge.difficulty === 'intermediate' ? 'bg-amber-950/50 text-amber-400 border-amber-800/60' : '',
            challenge.difficulty === 'advanced' ? 'bg-red-950/50 text-red-400 border-red-800/60' : '',
          ]}>
            {challenge.difficulty}
          </span>
        </div>
      </div>

      <!-- Left panel tabs: Description / Solutions -->
      <div class="desc-tabs flex border-b border-slate-800 text-[11px] font-semibold text-slate-400 -mx-6 px-6">
        <button
          id="desc-tab-problem-btn"
          class="px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer"
        >
          Problem
        </button>
        <button
          id="desc-tab-solutions-btn"
          class="px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer flex items-center gap-1.5"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.347.347A3.5 3.5 0 0111.5 18H9a3.5 3.5 0 01-3.5-3.5v-.1a3.5 3.5 0 011.018-2.45z" /></svg>
          Solutions
        </button>
      </div>

      <!-- Problem panel -->
      <div id="desc-panel-problem">
        <!-- Problem Statement -->
        <div class="space-y-4 text-sm text-slate-300 leading-relaxed">
          <p class="whitespace-pre-line">{challenge.description}</p>
        </div>

        <!-- Format details -->
        <div class="grid sm:grid-cols-2 gap-4 pt-4 border-t border-slate-800 mt-4">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-450 mb-1">Input Format</h3>
            <p class="text-xs text-slate-300 whitespace-pre-line">{challenge.inputFormat}</p>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-450 mb-1">Output Format</h3>
            <p class="text-xs text-slate-300 whitespace-pre-line">{challenge.outputFormat}</p>
          </div>
        </div>

        <!-- Constraints -->
        <div class="pt-4 border-t border-slate-800">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-455 mb-1">Constraints</h3>
          <code class="text-xs font-mono bg-slate-950 px-2 py-1 rounded text-slate-300 border border-slate-800/50 inline-block">
            {challenge.constraints}
          </code>
        </div>

        <!-- Sample test cases -->
        <div class="space-y-4 pt-4 border-t border-slate-800">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Example Test Cases</h3>
          
          {challenge.testCases.filter(tc => tc.isExample).map((tc, idx) => (
            <div class="space-y-2 dark-card border rounded-xl p-4">
              <div class="text-[10px] font-bold text-slate-450 uppercase tracking-wider">Example {idx + 1}</div>
              <div class="grid sm:grid-cols-2 gap-3">
                <div>
                  <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-1">Input</span>
                  <pre class="dark-pre font-mono text-xs p-2 rounded border overflow-x-auto">{tc.input}</pre>
                </div>
                <div>
                  <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-1">Expected Output</span>
                  <pre class="dark-pre font-mono text-xs p-2 rounded border overflow-x-auto text-emerald-450">{tc.expectedOutput}</pre>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Solutions panel (hidden by default) -->
      <div id="desc-panel-solutions" class="hidden space-y-4">
        {challenge.solutions && challenge.solutions.length > 0 ? (
          <>
            <div class="flex items-start gap-2 p-3 bg-amber-950/30 border border-amber-800/40 rounded-xl">
              <svg class="w-4 h-4 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
              <p class="text-xs text-amber-300/90">Try solving it yourself first! Solutions are here when you need a hint or want to compare approaches.</p>
            </div>
            {challenge.solutions.map((sol, idx) => (
              <div class="solution-card border border-slate-800 rounded-xl overflow-hidden">
                <button
                  class="sol-toggle w-full flex items-center justify-between px-4 py-3 text-left bg-slate-900/80 hover:bg-slate-800/80 transition-colors cursor-pointer"
                  data-sol-idx={idx}
                >
                  <div>
                    <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">Solution {idx + 1}</span>
                    <div class="text-sm font-semibold text-white mt-0.5">{sol.title}</div>
                    <p class="text-xs text-slate-400 mt-0.5">{sol.explanation}</p>
                  </div>
                  <svg class="sol-chevron w-4 h-4 text-slate-500 shrink-0 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </button>
                <div class="sol-body hidden bg-slate-950">
                  <pre class="solution-pre font-mono text-xs p-4 overflow-x-auto text-slate-200 leading-relaxed language-python">{sol.code}</pre>
                  <div class="px-4 pb-3 flex gap-2">
                    <button class="sol-try-btn text-[10px] font-bold text-indigo-400 hover:text-indigo-300 transition-colors cursor-pointer flex items-center gap-1" data-sol-code={sol.code}>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                      Load into Editor
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </>
        ) : (
          <div class="text-center py-12 text-slate-500">
            <svg class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.347.347A3.5 3.5 0 0111.5 18H9a3.5 3.5 0 01-3.5-3.5v-.1a3.5 3.5 0 011.018-2.45z" /></svg>
            <p class="text-sm font-medium">Solutions coming soon</p>
            <p class="text-xs mt-1">This challenge's editorial is being written.</p>
          </div>
        )}
      </div>
    </div>

    <!-- Right panel: Code Editor and Test runner -->
    <div class="editor-pane w-full lg:w-1/2 flex flex-col h-1/2 lg:h-full overflow-hidden">
      <!-- Editor Header -->
      <div class="editor-header flex items-center justify-between px-6 py-3 border-b">
        <span class="text-xs font-semibold flex items-center gap-1.5 text-slate-400">
          <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
          Python 3.x (Interactive Editor)
        </span>
        <button 
          id="btn-reset-code"
          class="text-xs font-semibold text-slate-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer"
          data-starter-code={challenge.starterCode}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18.5" />
          </svg>
          Reset Code
        </button>
      </div>

      <!-- Real-time Syntax Highlight CodeEditor -->
      <div class="flex-1 relative overflow-hidden flex min-h-[150px]">
        <!-- Gutter for line numbers -->
        <div id="line-gutter" class="gutter-lines w-12 border-r flex flex-col items-end pr-3 py-4 select-none font-mono text-xs leading-6 overflow-hidden">
          <span>1</span>
        </div>
        <!-- CodeJar Code element -->
        <div
          id="editor"
          class="language-python flex-1 h-full py-4 px-4 font-mono text-xs leading-6 focus:outline-none overflow-y-auto whitespace-pre tab-size-4"
          spellcheck="false"
        ></div>
      </div>

      <!-- Action Bar and test runner console -->
      <div class="console-panel flex flex-col shrink-0">
        <!-- Control buttons -->
        <div class="console-header flex items-center justify-between px-6 py-3 border-b">
          <div class="flex items-center gap-2">
            <!-- Pyodide Loader Status -->
            <span id="pyodide-status" class="text-xs text-slate-400 flex items-center gap-2 font-medium">
              <svg class="w-4 h-4 text-indigo-500 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Starting runner engine...
            </span>
          </div>

          <div class="flex items-center gap-3">
            <button
              id="btn-run-code"
              class="px-4 py-1.5 rounded-lg text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-100 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              disabled
            >
              Run Code
            </button>
            <button
              id="btn-submit-code"
              class="px-4 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-500/20 transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              disabled
            >
              Submit Code
            </button>
          </div>
        </div>

        <!-- Terminal tabs -->
        <div class="console-tabs flex border-b text-[11px] font-semibold text-slate-400">
          <button 
            id="tab-tests-btn"
            class="px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer"
          >
            Test Cases
          </button>
          <button 
            id="tab-output-btn"
            class="px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer"
          >
            Console Output
          </button>
          <button 
            id="tab-errors-btn"
            class="px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer"
          >
            Compiler Logs
          </button>
        </div>

        <!-- Test cases display results console -->
        <div class="console-body p-5 h-40 overflow-y-auto font-mono text-xs leading-relaxed">
          <!-- Tests tab panel -->
          <div id="panel-tests" class="space-y-3">
            <div class="text-slate-500">Click "Run Code" to compile and run example cases.</div>
          </div>
          <!-- Output tab panel -->
          <div id="panel-output" class="hidden whitespace-pre overflow-x-auto text-slate-300">
            No stdout generated yet. Run your code to see prints.
          </div>
          <!-- Errors tab panel -->
          <div id="panel-errors" class="hidden whitespace-pre overflow-x-auto text-red-400">
            No error logs. Code runs cleanly.
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- Load Pyodide and Prism asynchronously -->
<script is:inline src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-python.min.js"></script>

<!-- Server to client variables bridge -->
<script is:inline define:vars={{ challenge }}>
  window.challengeData = challenge;
</script>

<!-- Main Vite-bundled script -->
<script>
  import { CodeJar } from 'codejar';

  const challenge = (window as any).challengeData;
  let pyodideInstance: any = null;
  let isPyodideLoading = true;
  let jar: any = null;

  // ─────────────────────────────────────────────────────────────
  // Output normalization helper — used on BOTH sides of comparison
  // Strips CRLF, removes leading/trailing blank lines and spaces.
  // ─────────────────────────────────────────────────────────────
  function normalizeOutput(s: string): string {
    return s
      .replace(/\r\n/g, '\n')   // Windows line endings → Unix
      .replace(/\r/g, '\n')     // stray CR → LF
      .split('\n')
      .map((line: string) => line.trimEnd())   // trailing spaces per line
      .join('\n')
      .trim();                  // leading/trailing blank lines
  }

  // Initialize CodeJar editor
  function initEditor() {
    const editorEl = document.getElementById('editor');
    if (!editorEl) return;

    const highlight = (editor: HTMLElement) => {
      const code = editor.textContent || '';
      if ((window as any).Prism) {
        editor.innerHTML = (window as any).Prism.highlight(code, (window as any).Prism.languages.python, 'python');
      }
    };

    jar = CodeJar(editorEl, highlight);
    (window as any).__codeJar = jar;
    jar.updateCode(challenge.starterCode);
    
    jar.onUpdate((code: string) => {
      updateLineNumbers(code);
    });

    updateLineNumbers(challenge.starterCode);
  }

  function updateLineNumbers(code: string) {
    const gutter = document.getElementById('line-gutter');
    if (!gutter) return;
    const lines = code.split('\n').length;
    let numbersHtml = '';
    for (let i = 1; i <= lines; i++) {
      numbersHtml += `<span>${i}</span>`;
    }
    gutter.innerHTML = numbersHtml;
  }

  // Initialize Pyodide on page load
  async function initPyodide() {
    const statusLabel = document.getElementById('pyodide-status');
    const runBtn = document.getElementById('btn-run-code');
    const submitBtn = document.getElementById('btn-submit-code');

    try {
      if (typeof (window as any).loadPyodide === 'undefined') {
        throw new Error('Pyodide script failed to load from CDN.');
      }
      
      pyodideInstance = await (window as any).loadPyodide();
      isPyodideLoading = false;

      if (statusLabel) {
        statusLabel.innerHTML = `
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Ready to run
        `;
      }
      if (runBtn) runBtn.removeAttribute('disabled');
      if (submitBtn) submitBtn.removeAttribute('disabled');
    } catch (err: any) {
      console.error(err);
      if (statusLabel) {
        statusLabel.innerHTML = `
          <span class="w-2 h-2 rounded-full bg-red-500"></span>
          Engine error
        `;
      }
    }
  }

  // Console Tabs toggling logic
  function selectConsoleTab(tabName: string) {
    const tabs = ['tests', 'output', 'errors'];
    tabs.forEach(t => {
      const btn = document.getElementById(`tab-${t}-btn`);
      const panel = document.getElementById(`panel-${t}`);
      if (btn && panel) {
        if (t === tabName) {
          btn.className = 'px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer';
          panel.classList.remove('hidden');
        } else {
          btn.className = 'px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer';
          panel.classList.add('hidden');
        }
      }
    });
  }

  // Left panel: Description / Solutions tab toggling
  function selectDescTab(tabName: string) {
    const problemBtn = document.getElementById('desc-tab-problem-btn');
    const solutionsBtn = document.getElementById('desc-tab-solutions-btn');
    const problemPanel = document.getElementById('desc-panel-problem');
    const solutionsPanel = document.getElementById('desc-panel-solutions');

    const activeClass = 'px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer flex items-center gap-1.5';
    const inactiveClass = 'px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer flex items-center gap-1.5';
    const activeClassSimple = 'px-4 py-2 border-b-2 border-indigo-500 text-white focus:outline-none cursor-pointer';
    const inactiveClassSimple = 'px-4 py-2 border-b-2 border-transparent hover:text-white focus:outline-none cursor-pointer';

    if (tabName === 'problem') {
      if (problemBtn) problemBtn.className = activeClassSimple;
      if (solutionsBtn) solutionsBtn.className = activeClass;
      if (problemPanel) problemPanel.classList.remove('hidden');
      if (solutionsPanel) solutionsPanel.classList.add('hidden');
      // Fix: revert solutions button to inactive
      if (solutionsBtn) solutionsBtn.className = inactiveClass;
    } else {
      if (problemBtn) problemBtn.className = inactiveClassSimple;
      if (solutionsBtn) solutionsBtn.className = activeClass;
      if (problemPanel) problemPanel.classList.add('hidden');
      if (solutionsPanel) solutionsPanel.classList.remove('hidden');
    }
  }

  // ─────────────────────────────────────────────────────────────
  // Execute test cases — FIXED version
  // Fixes:
  //  1. Normalized output comparison (trimEnd on both sides)
  //  2. Shared exec_globals between user_code and validation_code
  //  3. builtins.input patched correctly inside exec context
  //  4. stdout buffer properly accumulated for Console Output tab
  //  5. Package loading with try/catch to not crash on already-loaded
  // ─────────────────────────────────────────────────────────────
  async function executeTestCases(submitMode = false) {
    const resultsConsole = document.getElementById('panel-tests');
    const stdoutConsole = document.getElementById('panel-output');
    const stderrConsole = document.getElementById('panel-errors');
    const statusLabel = document.getElementById('pyodide-status');

    if (!jar || !resultsConsole || !pyodideInstance) return;

    const editorEl = document.getElementById('editor');
    const userCode = (jar && typeof jar.toString === 'function'
      ? jar.toString()
      : (editorEl?.textContent || ''))
      .replace(/\r\n/g, '\n')
      .replace(/\r/g, '\n');
    (window as any).__lastUserCode = userCode;

    // Load packages if needed (guarded with try/catch for already-loaded)
    const packagesToLoad: string[] = [];
    if (userCode.includes('import numpy') || userCode.includes('from numpy') || userCode.includes('np.')) {
      packagesToLoad.push('numpy');
    }
    if (userCode.includes('import pandas') || userCode.includes('from pandas') || userCode.includes('pd.')) {
      packagesToLoad.push('pandas');
    }
    if (userCode.includes('import matplotlib') || userCode.includes('from matplotlib') || userCode.includes('plt.')) {
      packagesToLoad.push('matplotlib');
    }
    if (userCode.includes('import seaborn') || userCode.includes('from seaborn') || userCode.includes('sns.')) {
      packagesToLoad.push('seaborn');
    }

    for (const pkg of packagesToLoad) {
      if (statusLabel) {
        statusLabel.innerHTML = `
          <svg class="w-4 h-4 text-amber-500 animate-spin mr-1 inline-block" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Loading ${pkg}...
        `;
      }
      try {
        await pyodideInstance.loadPackage(pkg);
      } catch (_) {
        // Package may already be loaded — that's fine
      }
    }

    if (statusLabel) {
      statusLabel.innerHTML = `
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Running code...
      `;
    }

    // Determine validation code for plot-type challenges
    let validationCode = '';
    if (challenge.subCategory === 'matplotlib' || challenge.subCategory === 'seaborn') {
      const slug = challenge.slug;
      if (slug === 'your-first-line-plot') {
        validationCode = `
import matplotlib.pyplot as plt
fig = plt.gcf()
ax = plt.gca()
assert ax.get_title() != ""
assert ax.get_xlabel() != ""
assert ax.get_ylabel() != ""
assert len(ax.lines) > 0
print("PLOT_OK")
`;
      } else if (slug === 'bar-chart-from-data') {
        validationCode = `
import matplotlib.pyplot as plt
fig = plt.gcf()
ax = plt.gca()
assert ax.get_title() != ""
assert len(ax.containers) > 0 or len(ax.patches) > 0
print("PLOT_OK")
`;
      } else if (slug === 'scatter-plot-with-colors') {
        validationCode = `
import matplotlib.pyplot as plt
fig = plt.gcf()
ax = plt.gca()
assert len(ax.collections) > 0
print("PLOT_OK")
`;
      } else if (slug === 'multiple-series-on-one-plot') {
        validationCode = `
import matplotlib.pyplot as plt
fig = plt.gcf()
ax = plt.gca()
assert len(ax.lines) >= 2
assert ax.get_legend() is not None
print("PLOT_OK")
`;
      } else if (slug === 'subplots-grid') {
        validationCode = `
import matplotlib.pyplot as plt
fig = plt.gcf()
assert len(fig.axes) == 4
print("PLOT_OK")
`;
      } else if (slug === 'customizing-styles') {
        validationCode = `
import matplotlib.pyplot as plt
fig = plt.gcf()
ax = plt.gca()
assert len(ax.lines) > 0
print("PLOT_OK")
`;
      } else if (slug === 'saving-figures-to-file') {
        validationCode = `
import os
assert os.path.exists("plot.png")
print("PLOT_OK")
`;
      } else if (slug === 'histogram-distribution') {
        validationCode = `
import matplotlib.pyplot as plt
fig = plt.gcf()
ax = plt.gca()
assert len(ax.patches) > 0
print("PLOT_OK")
`;
      } else {
        validationCode = `
import matplotlib.pyplot as plt
fig = plt.gcf()
ax = plt.gca()
assert len(ax.collections) > 0 or len(ax.patches) > 0 or len(fig.axes) > 0
print("PLOT_OK")
`;
      }
    }

    // Filter test cases based on run mode
    const casesToRun = submitMode 
      ? challenge.testCases 
      : challenge.testCases.filter((tc: any) => tc.isExample);

    resultsConsole.innerHTML = '<div class="text-indigo-400 animate-pulse">Running test cases...</div>';
    if (stdoutConsole) stdoutConsole.textContent = '';
    if (stderrConsole) stderrConsole.textContent = '';
    
    // Mark as in progress
    const progressList = JSON.parse(localStorage.getItem('datalogify_in_progress_challenges') || '[]');
    if (!progressList.includes(challenge.id)) {
      progressList.push(challenge.id);
      localStorage.setItem('datalogify_in_progress_challenges', JSON.stringify(progressList));
    }

    let allPassed = true;
    let consoleOutputHtml = '';
    let globalStdoutBuffer = '';
    let globalStderrBuffer = '';

    for (let i = 0; i < casesToRun.length; i++) {
      const tc = casesToRun[i];
      const caseLabel = tc.isExample ? `Example Test Case ${i + 1}` : `Test Case ${i + 1}`;
      
      // Pass code and stdin into Pyodide globals safely (no brittle string interpolation)
      pyodideInstance.globals.set('user_code', userCode);
      pyodideInstance.globals.set('validation_code', validationCode);
      pyodideInstance.globals.set('stdin_text', tc.input || '');

      // ─── FIXED wrapper script ───────────────────────────────────────
      // Key fixes vs old version:
      //  - shared exec_globals dict so imports flow into validation_code
      //  - builtins.input patched at module level BEFORE exec, not inside dict
      //  - readline strips both \r\n and \n for Windows compatibility
      // ────────────────────────────────────────────────────────────────
      const wrapperScript = `
import sys
import io
import builtins
import traceback

# Set up stdin from the test case input string
sys.stdin = io.StringIO(stdin_text)

# Redirect stdout and stderr
stdout_buffer = io.StringIO()
stderr_buffer = io.StringIO()
old_stdout = sys.stdout
old_stderr = sys.stderr
sys.stdout = stdout_buffer
sys.stderr = stderr_buffer

# Patch builtins.input so it reads from our mocked stdin
# This is applied globally so it works inside user functions too
_real_input = builtins.input
def _mock_input(prompt=""):
    line = sys.stdin.readline()
    if not line:
        raise EOFError("No more input (EOF)")
    return line.rstrip("\\r\\n")

builtins.input = _mock_input

# Shared namespace for user code + validation code
# This allows 'import numpy as np' in user_code to be visible in validation_code
exec_globals = {"__builtins__": builtins}
execution_error = None

try:
    exec(compile(user_code, "<user_code>", "exec"), exec_globals)
    if validation_code:
        exec(compile(validation_code, "<validation>", "exec"), exec_globals)
except Exception as e:
    execution_error = traceback.format_exc()

finally:
    # Always restore real stdout/stderr and input
    sys.stdout = old_stdout
    sys.stderr = old_stderr
    builtins.input = _real_input

if execution_error:
    stderr_buffer.write(execution_error)

captured_stdout = stdout_buffer.getvalue()
captured_stderr = stderr_buffer.getvalue()
`;

      (window as any).__lastWrapper = wrapperScript;

      try {
        await pyodideInstance.runPythonAsync(wrapperScript);

        const capturedStdout = (pyodideInstance.globals.get('captured_stdout') || '') as string;
        const capturedStderr = (pyodideInstance.globals.get('captured_stderr') || '') as string;
        const executionError = (pyodideInstance.globals.get('execution_error') || null);

        // Accumulate stdout for Console Output tab
        if (capturedStdout) {
          globalStdoutBuffer += `[${caseLabel}]\n${capturedStdout}\n`;
        }

        if (capturedStderr) {
          globalStderrBuffer += `[${caseLabel}]\n${capturedStderr.trim()}\n\n`;
        }
        if (executionError) {
          globalStderrBuffer += `[${caseLabel}]\n${String(executionError).trim()}\n\n`;
        }

        // ── NORMALIZED comparison (key bug fix) ──────────────────────
        const actualOutput   = normalizeOutput(capturedStdout);
        const expectedOutput = normalizeOutput(tc.expectedOutput);
        // ────────────────────────────────────────────────────────────

        if (actualOutput === expectedOutput) {
          consoleOutputHtml += `
            <div class="border-l-2 border-emerald-500 pl-3 py-1 space-y-1">
              <div class="text-emerald-400 font-bold">Passed ✅ — ${caseLabel}</div>
              <div class="text-[10px] text-slate-500">Input: ${tc.input.replace(/\n/g, ' | ')}</div>
            </div>
          `;
        } else {
          allPassed = false;
          const displayActual = actualOutput || '(empty output)';
          const displayExpected = expectedOutput;
          consoleOutputHtml += `
            <div class="border-l-2 border-red-500 pl-3 py-1 space-y-1">
              <div class="text-red-400 font-bold">Failed ❌ — ${caseLabel}</div>
              <div class="text-[10px] text-slate-500">Input: ${tc.input.replace(/\n/g, ' | ')}</div>
              <div class="text-[10px] text-slate-400">Expected: <span class="text-emerald-400 font-mono">${displayExpected}</span></div>
              <div class="text-[10px] text-slate-400">Got:      <span class="text-red-400 font-mono">${displayActual}</span></div>
            </div>
          `;
        }
      } catch (err: any) {
        allPassed = false;
        globalStderrBuffer += `[${caseLabel}]\n${err.message}\n\n`;
        consoleOutputHtml += `
          <div class="border-l-2 border-red-500 pl-3 py-1 space-y-1">
            <div class="text-red-400 font-bold">Runtime Error ⚠️ — ${caseLabel}</div>
            <div class="text-[10px] text-slate-400">See Compiler Logs for stack trace.</div>
          </div>
        `;
      }
    }

    resultsConsole.innerHTML = consoleOutputHtml;
    if (stdoutConsole) stdoutConsole.textContent = globalStdoutBuffer || 'No stdout generated.';
    if (stderrConsole) stderrConsole.textContent = globalStderrBuffer || 'No compiler errors.';

    if (submitMode && allPassed) {
      // Mark as solved in localStorage
      const solvedList = JSON.parse(localStorage.getItem('datalogify_solved_challenges') || '[]');
      if (!solvedList.includes(challenge.id)) {
        solvedList.push(challenge.id);
        localStorage.setItem('datalogify_solved_challenges', JSON.stringify(solvedList));
      }
      
      resultsConsole.innerHTML += `
        <div class="mt-4 p-3 bg-emerald-950/40 border border-emerald-800/40 rounded-xl text-emerald-400 font-semibold text-center">
          🎉 All test cases passed — Submission Accepted!
        </div>
      `;
    } else if (submitMode && !allPassed) {
      resultsConsole.innerHTML += `
        <div class="mt-4 p-3 bg-red-950/30 border border-red-800/40 rounded-xl text-red-400 text-xs text-center">
          Some test cases failed. Review the output above and try again.
        </div>
      `;
    }

    // Reset status label back to Ready
    if (statusLabel) {
      statusLabel.innerHTML = `
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Ready to run
      `;
    }

    // Auto-switch tabs
    if (globalStderrBuffer && !allPassed) {
      selectConsoleTab('errors');
    } else {
      selectConsoleTab('tests');
    }
  }

  // Page lifecycle events
  document.addEventListener('astro:page-load', () => {
    // Initialize CodeJar editor
    initEditor();
    
    // Wire up reset button
    const resetBtn = document.getElementById('btn-reset-code');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        const starter = resetBtn.getAttribute('data-starter-code');
        if (jar && starter) {
          jar.updateCode(starter);
          updateLineNumbers(starter);
        }
      });
    }

    const runBtn = document.getElementById('btn-run-code');
    if (runBtn) {
      runBtn.addEventListener('click', () => executeTestCases(false));
    }

    const submitBtn = document.getElementById('btn-submit-code');
    if (submitBtn) {
      submitBtn.addEventListener('click', () => executeTestCases(true));
    }

    // Console tab clicks
    const tabs = ['tests', 'output', 'errors'];
    tabs.forEach(t => {
      const btn = document.getElementById(`tab-${t}-btn`);
      if (btn) {
        btn.addEventListener('click', () => selectConsoleTab(t));
      }
    });

    // Left panel (Problem / Solutions) tab clicks
    const problemTabBtn = document.getElementById('desc-tab-problem-btn');
    const solutionsTabBtn = document.getElementById('desc-tab-solutions-btn');
    if (problemTabBtn) {
      problemTabBtn.addEventListener('click', () => selectDescTab('problem'));
    }
    if (solutionsTabBtn) {
      solutionsTabBtn.addEventListener('click', () => selectDescTab('solutions'));
    }

    // Solution accordion toggles
    document.querySelectorAll('.sol-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.getAttribute('data-sol-idx');
        const body = btn.nextElementSibling as HTMLElement | null;
        const chevron = btn.querySelector('.sol-chevron') as HTMLElement | null;
        if (body) {
          body.classList.toggle('hidden');
          if (chevron) {
            chevron.style.transform = body.classList.contains('hidden') ? '' : 'rotate(180deg)';
          }
          // Syntax highlight the solution code
          if (!body.classList.contains('hidden')) {
            const pre = body.querySelector('.solution-pre') as HTMLElement | null;
            if (pre && (window as any).Prism) {
              const raw = pre.textContent || '';
              pre.innerHTML = (window as any).Prism.highlight(raw, (window as any).Prism.languages.python, 'python');
            }
          }
        }
      });
    });

    // "Load into Editor" buttons
    document.querySelectorAll('.sol-try-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-sol-code') || '';
        if (jar && code) {
          jar.updateCode(code);
          updateLineNumbers(code);
          // Switch to Problem tab so user can run it
          selectDescTab('problem');
          // Scroll to top of editor
          document.getElementById('editor')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Launch Pyodide compilation
    initPyodide();
  });
</script>

