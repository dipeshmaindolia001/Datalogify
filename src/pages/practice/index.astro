---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { challenges } from '../../data/practice-challenges';

const basicsChallenges = challenges.filter(c => c.section === 'basics');
const numpyChallenges = challenges.filter(c => c.section === 'libraries' && c.subCategory === 'numpy');
const pandasChallenges = challenges.filter(c => c.section === 'libraries' && c.subCategory === 'pandas');
const matplotlibChallenges = challenges.filter(c => c.section === 'libraries' && c.subCategory === 'matplotlib');
const seabornChallenges = challenges.filter(c => c.section === 'libraries' && c.subCategory === 'seaborn');
const algorithmsChallenges = challenges.filter(c => c.section === 'algorithms');

// Break basics into 11 tiers based on order ranges
const basicsTierRanges = [
  { key: 'tier1',  label: 'Syntax & I/O',         icon: '🌱', min: 1,  max: 8  },
  { key: 'tier2',  label: 'Variables & Types',     icon: '📦', min: 9,  max: 18 },
  { key: 'tier3',  label: 'Control Flow',          icon: '🔀', min: 19, max: 28 },
  { key: 'tier4',  label: 'Strings',               icon: '🔤', min: 29, max: 38 },
  { key: 'tier5',  label: 'Lists & Tuples',        icon: '📋', min: 39, max: 48 },
  { key: 'tier6',  label: 'Sets & Dicts',          icon: '🗂️', min: 49, max: 56 },
  { key: 'tier7',  label: 'Functions & Scope',     icon: '⚙️', min: 57, max: 66 },
  { key: 'tier8',  label: 'Comprehensions',        icon: '🔄', min: 67, max: 72 },
  { key: 'tier9',  label: 'OOP',                   icon: '🏗️', min: 73, max: 80 },
  { key: 'tier10', label: 'Errors & Files',        icon: '📂', min: 81, max: 86 },
  { key: 'tier11', label: 'Advanced',              icon: '🧬', min: 87, max: 90 },
];

const basicsTierChallenges = basicsTierRanges.map(t => ({
  ...t,
  challenges: basicsChallenges.filter(c => c.order >= t.min && c.order <= t.max),
}));

// Break NumPy into 6 tiers based on order ranges (orders 91-140)
const numpyTierRanges = [
  { key: 'np-tier1', label: 'Creation & Basics',     icon: '🧱', min: 91,  max: 98  },
  { key: 'np-tier2', label: 'Indexing & Slicing',    icon: '🔍', min: 99,  max: 106 },
  { key: 'np-tier3', label: 'Operations & Broadcasting', icon: '📡', min: 107, max: 114 },
  { key: 'np-tier4', label: 'Aggregation & Stats',   icon: '📊', min: 115, max: 122 },
  { key: 'np-tier5', label: 'Reshape & Stacking',    icon: '🔀', min: 123, max: 130 },
  { key: 'np-tier6', label: 'Linear Algebra & Advanced', icon: '🧮', min: 131, max: 140 },
];

const numpyTierChallenges = numpyTierRanges.map(t => ({
  ...t,
  challenges: numpyChallenges.filter(c => c.order >= t.min && c.order <= t.max),
}));

// Collect all tier data for metadata provider (basics + numpy)
const allTierData = [...basicsTierChallenges, ...numpyTierChallenges];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Interactive Python Coding Practice',
  description: 'Practice Python coding directly in your browser. Solve hands-on Python exercises, run tests, and check answers instantly with client-side WebAssembly.',
  provider: { '@type': 'Organization', name: 'Datalogify' },
  numberOfLessons: challenges.length,
};
---

<BaseLayout
  title="Interactive Coding Practice Arena — Python & SQL | Datalogify"
  description="Practice Python and SQL interactively. Write code directly in the browser and verify solutions with real-time test runners. Track your progress now!"
  jsonLd={jsonLd}
>
  <!-- Metadata provider to pass challenge IDs to client script dynamically -->
  <div 
    id="metadata-provider" 
    data-pandas-ids={JSON.stringify(pandasChallenges.map(c => c.id))}
    data-matplotlib-ids={JSON.stringify(matplotlibChallenges.map(c => c.id))}
    data-seaborn-ids={JSON.stringify(seabornChallenges.map(c => c.id))}
    data-algorithms-ids={JSON.stringify(algorithmsChallenges.map(c => c.id))}
    class="hidden"
  >
    {allTierData.map(t => (
      <span data-tier-ids={t.key} data-ids={JSON.stringify(t.challenges.map(c => c.id))}></span>
    ))}
  </div>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8 lg:py-12">
    <!-- Header banner -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 px-6 py-12 sm:px-12 sm:py-16 shadow-2xl mb-12 animate-fade-in">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,#312e81,transparent)] opacity-40"></div>
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl"></div>
      <div class="absolute right-12 bottom-12 text-7xl opacity-10 select-none animate-pulse">💻</div>
      
      <div class="relative z-10 max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 mb-4 uppercase tracking-wider">
          ⚡ Interactive Arena
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight min-h-[72px] sm:min-h-[96px] lg:min-h-[120px]">
          Practice <span id="typed-text" class="bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400 bg-clip-text text-transparent">Python</span><span class="typewriter-cursor text-indigo-400 animate-pulse ml-0.5">|</span> Coding <br/>
          Directly in Your Browser
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          Test your skills with HackerRank-style interactive challenges. Write code, run tests against multiple cases, and see instant feedback powered by in-browser WebAssembly.
        </p>
      </div>
    </div>

    <!-- Main Navigation Tabs (Python vs SQL) -->
    <div class="flex gap-4 border-b border-slate-200 pb-4 mb-8">
      <a 
        href="/practice/"
        class="px-5 py-2.5 rounded-xl text-sm font-bold bg-indigo-650 text-white shadow-md shadow-indigo-500/15 focus:outline-none flex items-center gap-2"
      >
        🐍 Python Practice
      </a>
      <a 
        href="/practice/sql/"
        class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-slate-50 text-slate-500 border border-slate-100 hover:bg-slate-100 hover:text-slate-700 transition-colors focus:outline-none flex items-center gap-2"
      >
        🗃️ SQL Practice
      </a>
    </div>

    <!-- Split Pane Layout: Sidebar + Challenge Cards -->
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Left Side: Sticky Navigation Sidebar -->
      <aside class="w-full lg:w-1/4 shrink-0 lg:sticky lg:top-24 h-fit">
        <div class="bg-white border border-slate-100 rounded-2xl p-4 space-y-1.5 shadow-sm max-h-[80vh] overflow-y-auto">
          <h3 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest px-3 mb-2">Language Basics</h3>
          
          {basicsTierChallenges.map((tier, idx) => (
            <button 
              data-track-btn={tier.key}
              class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
            >
              <span class="flex items-center gap-2">{tier.icon} Tier {idx + 1} — {tier.label}</span>
              <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id={`badge-count-${tier.key}`}>0/{tier.challenges.length}</span>
            </button>
          ))}

          <div class="h-px bg-slate-100 my-2"></div>
          <h3 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest px-3 mb-2">NumPy</h3>

          {numpyTierChallenges.map((tier, idx) => (
            <button 
              data-track-btn={tier.key}
              class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
            >
              <span class="flex items-center gap-2">{tier.icon} Tier {idx + 1} — {tier.label}</span>
              <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id={`badge-count-${tier.key}`}>0/{tier.challenges.length}</span>
            </button>
          ))}

          <div class="h-px bg-slate-100 my-2"></div>
          <h3 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest px-3 mb-2">Pandas</h3>

          <button 
            data-track-btn="pandas" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🐼 DataFrames & Analysis</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-pandas">0/{pandasChallenges.length}</span>
          </button>

          <div class="h-px bg-slate-100 my-2"></div>
          <h3 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest px-3 mb-2">Visualization</h3>

          <button 
            data-track-btn="matplotlib" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">📊 Matplotlib Plots</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-matplotlib">0/{matplotlibChallenges.length}</span>
          </button>

          <button 
            data-track-btn="seaborn" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🌊 Seaborn Statistics</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-seaborn">0/{seabornChallenges.length}</span>
          </button>

          <div class="h-px bg-slate-100 my-2"></div>
          <h3 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest px-3 mb-2">Problem Solving</h3>

          <button 
            data-track-btn="algorithms" 
            class="w-full text-left px-3 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all hover:bg-slate-50 border-l-4 border-transparent cursor-pointer"
          >
            <span class="flex items-center gap-2">🧠 Algorithms</span>
            <span class="text-[9px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full font-bold" id="badge-count-algorithms">0/{algorithmsChallenges.length}</span>
          </button>
        </div>
      </aside>

      <!-- Right Side: Challenge cards list matching selection -->
      <main class="flex-1 min-w-0">
        <!-- Per-Tier Panels for Language Basics -->
        {basicsTierChallenges.map((tier, idx) => (
          <div id={`track-panel-${tier.key}`} class="space-y-6 hidden">
            <div class="pb-3 border-b border-slate-100">
              <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">{tier.icon} Tier {idx + 1} — {tier.label}</h2>
              <p class="text-xs text-slate-450 mt-1">Questions {tier.min}–{tier.max} · {tier.challenges.length} challenges</p>
            </div>
            <div class="grid md:grid-cols-2 gap-6">
              {tier.challenges.map((challenge) => (
                <a
                  href={`/practice/${challenge.slug}/`}
                  class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
                >
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="text-xs font-bold text-slate-350">#{challenge.order}</span>
                        <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-650 transition-colors truncate">
                          {challenge.title}
                        </h3>
                      </div>
                      <p class="text-xs text-slate-450 line-clamp-2">{challenge.description}</p>
                    </div>
                  </div>
                  <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                    <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-50 text-emerald-600 border border-emerald-100">
                      {challenge.difficulty}
                    </span>
                    <span 
                      data-challenge-status={challenge.id}
                      class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                    >
                      Not Started
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}

        <!-- Per-Tier Panels for NumPy -->
        {numpyTierChallenges.map((tier, idx) => (
          <div id={`track-panel-${tier.key}`} class="space-y-6 hidden">
            <div class="pb-3 border-b border-slate-100">
              <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">{tier.icon} Tier {idx + 1} — {tier.label}</h2>
              <p class="text-xs text-slate-450 mt-1">{tier.challenges.length} challenges</p>
            </div>
            <div class="grid md:grid-cols-2 gap-6">
              {tier.challenges.map((challenge) => (
                <a
                  href={`/practice/${challenge.slug}/`}
                  class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
                >
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="text-xs font-bold text-slate-350">#{challenge.order}</span>
                        <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-650 transition-colors truncate">
                          {challenge.title}
                        </h3>
                      </div>
                      <p class="text-xs text-slate-450 line-clamp-2">{challenge.description}</p>
                    </div>
                  </div>
                  <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                    <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-50 text-indigo-600 border border-indigo-100">
                      {challenge.difficulty}
                    </span>
                    <span 
                      data-challenge-status={challenge.id}
                      class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                    >
                      Not Started
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}

        <!-- Section: Pandas -->
        <div id="track-panel-pandas" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">🐼 Pandas DataFrames & Analysis</h2>
            <p class="text-xs text-slate-450 mt-1">Analyze tabular data, pivot tables, missing values, and date columns</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {pandasChallenges.map((challenge) => (
              <a
                href={`/practice/${challenge.slug}/`}
                class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-bold text-slate-350">#{challenge.order}</span>
                      <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-650 transition-colors truncate">
                        {challenge.title}
                      </h3>
                    </div>
                    <p class="text-xs text-slate-450 line-clamp-2">{challenge.description}</p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-50 text-indigo-600 border border-indigo-100">
                    {challenge.difficulty}
                  </span>
                  <span 
                    data-challenge-status={challenge.id}
                    class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                  >
                    Not Started
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Section: Matplotlib -->
        <div id="track-panel-matplotlib" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">📊 Matplotlib Plots & Customization</h2>
            <p class="text-xs text-slate-450 mt-1">Plot line charts, subplots, customize styles, and save figures</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {matplotlibChallenges.map((challenge) => (
              <a
                href={`/practice/${challenge.slug}/`}
                class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-bold text-slate-350">#{challenge.order}</span>
                      <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-650 transition-colors truncate">
                        {challenge.title}
                      </h3>
                    </div>
                    <p class="text-xs text-slate-450 line-clamp-2">{challenge.description}</p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-50 text-indigo-600 border border-indigo-100">
                    {challenge.difficulty}
                  </span>
                  <span 
                    data-challenge-status={challenge.id}
                    class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                  >
                    Not Started
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Section: Seaborn -->
        <div id="track-panel-seaborn" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">🌊 Seaborn Statistics Visualization</h2>
            <p class="text-xs text-slate-450 mt-1">Master boxplots, countplots, correlation heatmaps, and pairplots</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {seabornChallenges.map((challenge) => (
              <a
                href={`/practice/${challenge.slug}/`}
                class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-bold text-slate-350">#{challenge.order}</span>
                      <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-650 transition-colors truncate">
                        {challenge.title}
                      </h3>
                    </div>
                    <p class="text-xs text-slate-450 line-clamp-2">{challenge.description}</p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-indigo-50 text-indigo-600 border border-indigo-100">
                    {challenge.difficulty}
                  </span>
                  <span 
                    data-challenge-status={challenge.id}
                    class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                  >
                    Not Started
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Section: Algorithms -->
        <div id="track-panel-algorithms" class="space-y-6 hidden">
          <div class="pb-3 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 text-lg sm:text-xl flex items-center gap-2">🧠 Algorithms & Problem Solving</h2>
            <p class="text-xs text-slate-450 mt-1">Practice sequences, anagram groupings, and string pattern lookups</p>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            {algorithmsChallenges.map((challenge) => (
              <a
                href={`/practice/${challenge.slug}/`}
                class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-bold text-slate-355">#{challenge.order}</span>
                      <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-660 transition-colors truncate">
                        {challenge.title}
                      </h3>
                    </div>
                    <p class="text-xs text-slate-450 line-clamp-2">{challenge.description}</p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between border-t border-slate-55 pt-3">
                  <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-red-50 text-red-600 border border-red-100">
                    {challenge.difficulty}
                  </span>
                  <span 
                    data-challenge-status={challenge.id}
                    class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400 border border-slate-100"
                  >
                    Not Started
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  // Page load setups
  document.addEventListener('astro:page-load', () => {
    // 1. LocalStorage Challenge Badges & Sidebar Solved Counts
    const solvedList = JSON.parse(localStorage.getItem('datalogify_solved_challenges') || '[]');
    const progressList = JSON.parse(localStorage.getItem('datalogify_in_progress_challenges') || '[]');

    // Build challenge mappings dynamically from server-rendered metadata
    const meta = document.getElementById('metadata-provider') as HTMLElement | null;
    const challengeMappings: Record<string, string[]> = {};

    if (meta) {
      // Read tier IDs from nested spans (basics + numpy tiers)
      const tierSpans = meta.querySelectorAll('[data-tier-ids]');
      tierSpans.forEach(span => {
        const key = span.getAttribute('data-tier-ids') || '';
        challengeMappings[key] = JSON.parse(span.getAttribute('data-ids') || '[]');
      });
      // Remaining library + algorithms tracks
      challengeMappings['pandas'] = JSON.parse(meta.dataset.pandasIds || '[]');
      challengeMappings['matplotlib'] = JSON.parse(meta.dataset.matplotlibIds || '[]');
      challengeMappings['seaborn'] = JSON.parse(meta.dataset.seabornIds || '[]');
      challengeMappings['algorithms'] = JSON.parse(meta.dataset.algorithmsIds || '[]');
    }

    // Calculate solved counts for badges
    Object.keys(challengeMappings).forEach(trackKey => {
      const ids = challengeMappings[trackKey];
      const solvedInTrack = ids.filter(id => solvedList.includes(id)).length;
      const totalInTrack = ids.length;
      const countBadge = document.getElementById(`badge-count-${trackKey}`);
      if (countBadge) {
        countBadge.textContent = `${solvedInTrack}/${totalInTrack}`;
        // Color badge based on completed
        if (solvedInTrack === totalInTrack && totalInTrack > 0) {
          countBadge.className = 'text-[9px] bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-bold';
        } else if (solvedInTrack > 0) {
          countBadge.className = 'text-[9px] bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full font-bold';
        }
      }
    });

    // Update statuses for individual challenge cards
    const statusBadges = document.querySelectorAll('[data-challenge-status]');
    statusBadges.forEach((badge) => {
      const challengeId = badge.getAttribute('data-challenge-status');
      if (!challengeId) return;

      if (solvedList.includes(challengeId)) {
        badge.textContent = 'Solved';
        badge.className = 'text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-100 text-emerald-700 border border-emerald-200';
      } else if (progressList.includes(challengeId)) {
        badge.textContent = 'In Progress';
        badge.className = 'text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-amber-100 text-amber-700 border border-amber-200';
      }
    });

    // 2. Sidebar Track Selection Routing
    const trackBtns = document.querySelectorAll('[data-track-btn]');
    const activeBtnClass = 'text-indigo-600 bg-indigo-50/70 border-l-4 border-indigo-500 font-bold pl-2';
    const inactiveBtnClass = 'text-slate-600 hover:bg-slate-50 border-l-4 border-transparent';

    function selectTrack(trackName: string) {
      trackBtns.forEach(btn => {
        const name = btn.getAttribute('data-track-btn');
        const panel = document.getElementById(`track-panel-${name}`);
        if (panel) {
          if (name === trackName) {
            btn.className = `w-full text-left px-3 py-2.5 rounded-xl text-xs flex items-center justify-between transition-all ${activeBtnClass} cursor-pointer`;
            panel.classList.remove('hidden');
          } else {
            btn.className = `w-full text-left px-3 py-2.5 rounded-xl text-xs flex items-center justify-between transition-all ${inactiveBtnClass} cursor-pointer`;
            panel.classList.add('hidden');
          }
        }
      });
      // Save track selection in URL hash
      window.location.hash = trackName;
    }

    // Initialize track selection from URL hash (default to tier1)
    const initialTrack = window.location.hash.replace('#', '') || 'tier1';
    selectTrack(initialTrack);

    // Bind sidebar clicks
    trackBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const trackName = btn.getAttribute('data-track-btn') || 'tier1';
        selectTrack(trackName);
      });
    });

    // 3. Typewriter alternates "Python" vs "SQL"
    const words = ['Python', 'SQL'];
    let wordIdx = 0;
    const typedTextEl = document.getElementById('typed-text');
    
    if (typedTextEl) {
      let charIdx = words[wordIdx].length;
      let isDeleting = true;
      let typingSpeed = 150;
      let timeoutId: any = null;

      function typeEffect() {
        const currentWord = words[wordIdx];
        if (isDeleting) {
          charIdx--;
          typingSpeed = 80;
        } else {
          charIdx++;
          typingSpeed = 150;
        }

        typedTextEl.textContent = currentWord.substring(0, charIdx);

        if (!isDeleting && charIdx === currentWord.length) {
          isDeleting = true;
          typingSpeed = 2000; // Pause at full word
        } else if (isDeleting && charIdx === 0) {
          isDeleting = false;
          wordIdx = (wordIdx + 1) % words.length;
          typingSpeed = 500; // Pause before typing next word
        }

        timeoutId = setTimeout(typeEffect, typingSpeed);
      }
      
      // Start typing loop
      timeoutId = setTimeout(typeEffect, 1500);

      // Clean up timeout on page unload to prevent memory leaks
      document.addEventListener('astro:before-preparation', () => {
        if (timeoutId) clearTimeout(timeoutId);
      }, { once: true });
    }
  });
</script>

<style>
  /* Typewriter blinking cursor helper */
  .typewriter-cursor {
    font-weight: 200;
  }
</style>
