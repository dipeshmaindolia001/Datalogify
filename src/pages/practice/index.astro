---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { challenges } from '../../data/practice-challenges';

const basicChallenges = challenges.filter(c => c.difficulty === 'basic');
const intermediateChallenges = challenges.filter(c => c.difficulty === 'intermediate');
const advancedChallenges = challenges.filter(c => c.difficulty === 'advanced');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Python Interactive Coding Practice',
  description: 'Practice Python coding directly in your browser. Solve hands-on Python exercises, run tests, and check answers instantly with client-side WebAssembly.',
  provider: { '@type': 'Organization', name: 'Datalogify' },
  numberOfLessons: challenges.length,
};
---

<BaseLayout
  title="Interactive Python Coding Practice — Code, Run & Solve | Datalogify"
  description="Solve interactive Python programming challenges directly in the browser. Run test cases instantly with client-side WebAssembly execution. Start practicing now!"
  jsonLd={jsonLd}
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-8 lg:py-12">
    <!-- Header banner -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 px-6 py-12 sm:px-12 sm:py-16 shadow-2xl mb-12 animate-fade-in">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,#312e81,transparent)] opacity-40"></div>
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl"></div>
      <div class="absolute right-12 bottom-12 text-7xl opacity-10 select-none animate-pulse">💻</div>
      
      <div class="relative z-10 max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 mb-4 uppercase tracking-wider">
          ⚡ Interactive Arena
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Practice Python Coding <br/>
          <span class="bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400 bg-clip-text text-transparent">Directly in Your Browser</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          Test your skills with HackerRank-style interactive challenges. Write Python code, run tests against multiple cases, and see instant feedback powered by in-browser WebAssembly.
        </p>
      </div>
    </div>

    <!-- Challenges layout -->
    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Basic Section -->
      <div>
        <div class="flex items-center gap-2 mb-6 pb-2 border-b border-slate-100">
          <span class="text-xl">🟢</span>
          <div>
            <h2 class="font-bold text-slate-800 text-lg">Basic Foundations</h2>
            <p class="text-xs text-slate-400">{basicChallenges.length} challenges · For absolute beginners</p>
          </div>
        </div>
        <div class="space-y-4">
          {basicChallenges.map((challenge) => (
            <a
              href={`/practice/${challenge.slug}/`}
              class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-bold text-slate-300">#{challenge.order}</span>
                    <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors truncate">
                      {challenge.title}
                    </h3>
                  </div>
                  <p class="text-xs text-slate-400 line-clamp-2">{challenge.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-50 text-emerald-600 border border-emerald-100">
                  Easy
                </span>
                <span 
                  data-challenge-status={challenge.id}
                  class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400"
                >
                  Not Started
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Intermediate Section -->
      <div>
        <div class="flex items-center gap-2 mb-6 pb-2 border-b border-slate-100">
          <span class="text-xl">🟡</span>
          <div>
            <h2 class="font-bold text-slate-800 text-lg">Intermediate Skills</h2>
            <p class="text-xs text-slate-400">{intermediateChallenges.length} challenges · Loops, Lists, String logic</p>
          </div>
        </div>
        <div class="space-y-4">
          {intermediateChallenges.map((challenge) => (
            <a
              href={`/practice/${challenge.slug}/`}
              class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-bold text-slate-300">#{challenge.order}</span>
                    <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors truncate">
                      {challenge.title}
                    </h3>
                  </div>
                  <p class="text-xs text-slate-400 line-clamp-2">{challenge.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-amber-50 text-amber-600 border border-amber-100">
                  Medium
                </span>
                <span 
                  data-challenge-status={challenge.id}
                  class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400"
                >
                  Not Started
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Advanced Section -->
      <div>
        <div class="flex items-center gap-2 mb-6 pb-2 border-b border-slate-100">
          <span class="text-xl">🟠</span>
          <div>
            <h2 class="font-bold text-slate-800 text-lg">Advanced Mastery</h2>
            <p class="text-xs text-slate-400">{advancedChallenges.length} challenges · Algos, Regex, Sequences</p>
          </div>
        </div>
        <div class="space-y-4">
          {advancedChallenges.map((challenge) => (
            <a
              href={`/practice/${challenge.slug}/`}
              class="group block bg-white border border-slate-100 rounded-2xl p-5 hover:border-indigo-200 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-bold text-slate-300">#{challenge.order}</span>
                    <h3 class="text-sm font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors truncate">
                      {challenge.title}
                    </h3>
                  </div>
                  <p class="text-xs text-slate-400 line-clamp-2">{challenge.description}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-red-50 text-red-600 border border-red-100">
                  Hard
                </span>
                <span 
                  data-challenge-status={challenge.id}
                  class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-50 text-slate-400"
                >
                  Not Started
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Dynamically load states from LocalStorage on page mount
  document.addEventListener('astro:page-load', () => {
    const solvedList = JSON.parse(localStorage.getItem('datalogify_solved_challenges') || '[]');
    const progressList = JSON.parse(localStorage.getItem('datalogify_in_progress_challenges') || '[]');

    const statusBadges = document.querySelectorAll('[data-challenge-status]');
    statusBadges.forEach((badge) => {
      const challengeId = badge.getAttribute('data-challenge-status');
      if (!challengeId) return;

      if (solvedList.includes(challengeId)) {
        badge.textContent = 'Solved';
        badge.className = 'text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-100 text-emerald-700';
      } else if (progressList.includes(challengeId)) {
        badge.textContent = 'In Progress';
        badge.className = 'text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-amber-100 text-amber-700';
      }
    });
  });
</script>
