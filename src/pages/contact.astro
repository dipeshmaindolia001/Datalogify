---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = Astro.site?.toString() || 'https://datalogify.com/';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', position: 1, name: 'Home', item: baseUrl },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${baseUrl}contact/` }
  ]
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'url': `${baseUrl}contact/`,
  'name': 'Contact Us | Datalogify',
  'description': 'Contact the Datalogify team for queries regarding our Python, SQL, Excel, and data analytics tutorials.'
};
---

<BaseLayout 
  title="Contact Us" 
  description="Have questions about our tutorials or want to collaborate? Reach out to the Datalogify team using our contact form."
  jsonLd={jsonLd}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 animate-slide-up">
    <div class="grid md:grid-cols-5 gap-12">
      <!-- Left side: info -->
      <div class="md:col-span-2 space-y-6">
        <div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-600 uppercase tracking-wider mb-4">
            Get In Touch
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-none">
            Contact Us
          </h1>
        </div>
        <p class="text-slate-500 text-sm leading-relaxed">
          Have questions about our data analytics roadmap? Spotted a typo in a SQL or Python code snippet? Or want to collaborate on creating custom analytics projects? Drop us a message and we'll get back to you.
        </p>
        <div class="pt-6 space-y-4 text-sm text-slate-600">
          <div class="flex items-center gap-3">
            <span class="text-xl">📧</span>
            <span class="font-medium">support@datalogify.com</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xl">🐦</span>
            <a href="https://twitter.com/datalogify" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 transition-colors">@datalogify</a>
          </div>
        </div>
      </div>

      <!-- Right side: form -->
      <div class="md:col-span-3 bg-slate-50/50 border border-slate-100 rounded-2xl p-6 sm:p-8 shadow-sm">
        <form 
          id="contact-form" 
          action="https://formspree.io/f/YOUR_FORM_ID" 
          method="POST" 
          class="space-y-4"
        >
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Full Name</label>
            <input 
              type="text" 
              name="name" 
              id="name" 
              required
              placeholder="Alex Johnson"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400 bg-white text-slate-800"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Email Address</label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required
              placeholder="alex@example.com"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400 bg-white text-slate-800"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Your Message</label>
            <textarea 
              name="message" 
              id="message" 
              rows="5" 
              required
              placeholder="Hi Datalogify team, I wanted to ask about..."
              class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400 bg-white text-slate-800"
            ></textarea>
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full py-3 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-md transition-colors cursor-pointer"
          >
            Send Message
          </button>
        </form>

        <div id="success-msg" class="hidden text-center py-8 space-y-3">
          <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mx-auto shadow-sm">✓</div>
          <h3 class="text-base font-bold text-slate-800">Message Sent!</h3>
          <p class="text-xs text-slate-500">Thank you for reaching out. We will get back to you shortly.</p>
          <button 
            id="reset-btn"
            class="text-xs text-indigo-600 hover:text-indigo-700 font-semibold underline mt-2"
          >
            Send another message
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function initContactForm() {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const success = document.getElementById('success-msg');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
      const resetBtn = document.getElementById('reset-btn');

      if (form && success && submitBtn) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending...';

          const action = form.getAttribute('action');
          const formData = new FormData(form);

          // If the template hasn't replaced the Formspree ID, fallback to mock submit
          if (action?.includes('YOUR_FORM_ID')) {
            await new Promise((resolve) => setTimeout(resolve, 1000));
          } else {
            try {
              await fetch(action || '', {
                method: 'POST',
                body: formData,
                headers: { 'Accept': 'application/json' }
              });
            } catch (err) {
              console.error('Submission error, falling back to mock UI');
            }
          }

          form.classList.add('hidden');
          success.classList.remove('hidden');
        });
      }

      if (resetBtn && form && success && submitBtn) {
        resetBtn.addEventListener('click', () => {
          form.reset();
          success.classList.add('hidden');
          form.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        });
      }
    }

    // Run on initial load
    initContactForm();

    // Re-run after view transitions
    document.addEventListener('astro:page-load', initContactForm);
  </script>
</BaseLayout>
