---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Internal Server Error">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
    <div class="animate-slide-up">
      <!-- 500 illustration -->
      <div class="relative inline-block mb-8">
        <span class="text-[10rem] font-extrabold text-slate-100 select-none leading-none">500</span>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-6xl">💥</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Internal Server Error
      </h1>
      <p class="mt-4 text-lg text-slate-500 max-w-md mx-auto">
        Something went wrong in our data pipeline. Don't worry, our engineers are parsing the logs to fix it.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 text-white font-semibold shadow-lg shadow-indigo-200/50 hover:bg-indigo-700 transition-all hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Go Home
        </a>
        <a
          href="/python/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-slate-700 font-semibold border border-slate-200 hover:border-indigo-200 hover:text-indigo-600 transition-all hover:-translate-y-0.5"
        >
          Start Learning
        </a>
      </div>

      <!-- Quick links -->
      <div class="mt-14 grid sm:grid-cols-3 gap-3 max-w-lg mx-auto">
        {[
          { label: 'Python Lessons', href: '/python/', icon: '🐍' },
          { label: 'SQL Lessons', href: '/sql/', icon: '🗃️' },
          { label: 'Learning Roadmap', href: '/roadmap/', icon: '🗺️' },
        ].map((link) => (
          <a href={link.href} class="flex items-center gap-2 p-3 rounded-lg bg-slate-50 text-sm text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-colors border border-slate-100">
            <span>{link.icon}</span>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
