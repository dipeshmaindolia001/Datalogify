---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allLessons = await getCollection('lessons');
const pythonCount = allLessons.filter(l => l.data.category === 'python').length;
const sqlCount = allLessons.filter(l => l.data.category === 'sql').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Datalogify',
  description: 'Free, hands-on data analytics learning platform — Python, SQL, Excel, EDA, Statistics, and Interview Prep.',
  publisher: { '@type': 'Organization', name: 'Datalogify' },
};
---

<BaseLayout
  title="About — Free Data Analytics Learning Platform"
  description="Datalogify is a free, open learning platform teaching data analytics through hands-on, practical lessons — no fluff, no video lectures, just real code."
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="animate-slide-up">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        About Datalogify
      </h1>
      <p class="mt-4 text-xl text-slate-500 leading-relaxed max-w-2xl">
        A free, structured learning platform that teaches data analytics through
        <strong class="text-slate-700">hands-on practice</strong> instead of hour-long videos.
      </p>
    </div>

    <div class="mt-16 space-y-16">
      <!-- Philosophy -->
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-indigo-100 text-lg">⚡</span>
          Our Philosophy
        </h2>
        <div class="prose max-w-none">
          <p>
            Most learning platforms make you watch 40-minute videos to learn something you could read in 3 minutes.
            We don't do that. <strong>Every concept gets 2-3 lines of context, then goes straight into code.</strong>
          </p>
          <p>Every lesson on Datalogify follows the same structure:</p>
          <ol>
            <li><strong>Concept</strong> — Super short, plain language explanation of why this matters</li>
            <li><strong>Real Code</strong> — Runnable, copy-pasteable, using realistic data scenarios</li>
            <li><strong>Output</strong> — Shown immediately so you know exactly what to expect</li>
            <li><strong>Real-World Context</strong> — Where this shows up in actual jobs and interviews</li>
            <li><strong>Challenge</strong> — A mini-project to cement what you just learned</li>
            <li><strong>Interview Questions</strong> — Common questions + answers for every topic</li>
          </ol>
          <p>
            The tone is direct and practical — like a senior data analyst mentoring you over coffee,
            not a professor reading from slides.
          </p>
        </div>
      </section>

      <!-- What's Available -->
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-100 text-lg">📚</span>
          What's Available
        </h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <a href="/python/" class="group p-6 bg-white rounded-xl border border-slate-100 hover:border-indigo-200 hover:shadow-md transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">🐍</span>
              <div>
                <h3 class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">Python Tutorial</h3>
                <p class="text-xs text-slate-400">{pythonCount} lessons · Basics → Advanced</p>
              </div>
            </div>
            <p class="text-sm text-slate-500">Variables, data types, Pandas, NumPy, visualization, APIs, and advanced patterns.</p>
          </a>
          <a href="/sql/" class="group p-6 bg-white rounded-xl border border-slate-100 hover:border-blue-200 hover:shadow-md transition-all">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">🗃️</span>
              <div>
                <h3 class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors">SQL Tutorial</h3>
                <p class="text-xs text-slate-400">{sqlCount} lessons · Basics → Advanced</p>
              </div>
            </div>
            <p class="text-sm text-slate-500">SELECT, JOINs, GROUP BY, window functions, CTEs, optimization, and design.</p>
          </a>
        </div>
        <p class="text-sm text-slate-400 mt-4">
          Excel, EDA, Statistics, Portfolio Projects, and Interview Prep sections are being written now.
          <a href="/roadmap/" class="text-indigo-600 hover:underline">See the full roadmap →</a>
        </p>
      </section>

      <!-- Who This Is For -->
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-violet-100 text-lg">🎯</span>
          Who This Is For
        </h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {[
            { title: 'Career Switchers', desc: 'Moving into data analytics from another field and need structured, practical skills.' },
            { title: 'Students', desc: 'Learning data analytics in school but want hands-on practice beyond textbooks.' },
            { title: 'Self-Taught Analysts', desc: 'Filling knowledge gaps and preparing for technical interviews.' },
            { title: 'Working Professionals', desc: 'Upskilling in Python, SQL, or statistics to become more data-driven.' },
          ].map((person) => (
            <div class="p-5 bg-slate-50 rounded-xl border border-slate-100">
              <h3 class="font-semibold text-slate-800 mb-1">{person.title}</h3>
              <p class="text-sm text-slate-500">{person.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- How We're Different -->
      <section>
        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-amber-100 text-lg">💎</span>
          How We're Different
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b-2 border-slate-200">
                <th class="text-left py-3 px-4 text-slate-500 font-medium">Feature</th>
                <th class="text-center py-3 px-4 text-slate-500 font-medium">Typical Course</th>
                <th class="text-center py-3 px-4 text-indigo-600 font-bold">Datalogify</th>
              </tr>
            </thead>
            <tbody class="text-slate-600">
              <tr class="border-b border-slate-100"><td class="py-3 px-4">Format</td><td class="text-center py-3 px-4">40-min videos</td><td class="text-center py-3 px-4 text-indigo-700 font-medium">Concise text + code</td></tr>
              <tr class="border-b border-slate-100"><td class="py-3 px-4">Code</td><td class="text-center py-3 px-4">Pseudocode</td><td class="text-center py-3 px-4 text-indigo-700 font-medium">Real, runnable</td></tr>
              <tr class="border-b border-slate-100"><td class="py-3 px-4">Context</td><td class="text-center py-3 px-4">Academic</td><td class="text-center py-3 px-4 text-indigo-700 font-medium">Real job scenarios</td></tr>
              <tr class="border-b border-slate-100"><td class="py-3 px-4">Interview Prep</td><td class="text-center py-3 px-4">Separate course</td><td class="text-center py-3 px-4 text-indigo-700 font-medium">Built into every lesson</td></tr>
              <tr class="border-b border-slate-100"><td class="py-3 px-4">Price</td><td class="text-center py-3 px-4">$50-200/mo</td><td class="text-center py-3 px-4 text-indigo-700 font-medium">Free forever</td></tr>
              <tr><td class="py-3 px-4">Coverage</td><td class="text-center py-3 px-4">One topic</td><td class="text-center py-3 px-4 text-indigo-700 font-medium">Full analytics stack</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Open & Free -->
      <section class="bg-gradient-to-br from-indigo-50 to-violet-50 rounded-2xl p-8 border border-indigo-100">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">🆓 Free & Open</h2>
        <p class="text-slate-600 leading-relaxed">
          Datalogify is and will always be <strong>completely free</strong>. No sign-up walls, no premium tiers,
          no "unlock the full course for $99." Every lesson, every code example, every interview question
          is available to everyone, right now. Learning shouldn't have a paywall.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
