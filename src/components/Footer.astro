---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Learning Roadmap', href: '/roadmap/' },
  { label: 'Python for Analytics', href: '/python/' },
  { label: 'SQL Fundamentals', href: '/sql/' },
  { label: 'Excel Mastery', href: '/excel/' },
  { label: 'Projects', href: '/projects/' },
];

const resources = [
  { label: 'About Datalogify', href: '/about/' },
  { label: 'Interview Prep', href: '/interview-prep/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'EDA Lessons', href: '/eda/' },
  { label: 'Statistics', href: '/statistics/' },
];
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <!-- About -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-4">
          <svg class="h-6 w-6 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="12" width="4" height="9" rx="1" fill="currentColor" opacity="0.3" />
            <rect x="10" y="7" width="4" height="14" rx="1" fill="currentColor" opacity="0.5" />
            <rect x="17" y="3" width="4" height="18" rx="1" fill="currentColor" opacity="0.8" />
          </svg>
          <span class="text-lg font-bold text-slate-800">Datalogify</span>
        </a>
        <p class="text-sm text-slate-600 leading-relaxed max-w-xs">
          Your free, structured path to becoming a data analyst. Learn Python, SQL, Excel, 
          and real-world analytics skills — from zero to job-ready.
        </p>
        <p class="mt-4 text-xs font-medium text-indigo-600">
          Built for aspiring data analysts ✨
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-800 mb-4">
          Quick Links
        </h3>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-slate-600 hover:text-indigo-600 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-800 mb-4">
          Resources
        </h3>
        <ul class="space-y-2.5">
          {resources.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-slate-600 hover:text-indigo-600 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-200 text-center">
      <p class="text-sm text-slate-500">
        &copy; {currentYear} Datalogify. All rights reserved.
      </p>
      <p class="mt-1 text-xs text-slate-400">
        Built with ❤️ for aspiring data analysts
      </p>
    </div>
  </div>
</footer>
