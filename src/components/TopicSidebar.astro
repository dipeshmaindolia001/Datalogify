---
/**
 * W3Schools/GFG-inspired topic sidebar.
 * Shows ALL lessons in the current category, grouped by difficulty level.
 * Highlights the current lesson. Always visible on desktop.
 */
import { getCollection } from 'astro:content';

interface Props {
  category: string;
  currentSlug?: string;
}

const { category, currentSlug = '' } = Astro.props;

const lessons = (await getCollection('lessons', ({ data }) => data.category === category))
  .sort((a, b) => a.data.order - b.data.order);

function getSlug(id: string): string {
  return id.replace(new RegExp(`^${category}/`), '');
}

// Group lessons by difficulty tiers (order ranges)
const beginnerLessons = lessons.filter(l => l.data.order >= 1 && l.data.order <= 100);
const intermediateLessons = lessons.filter(l => l.data.order >= 101 && l.data.order <= 200);
const advancedLessons = lessons.filter(l => l.data.order >= 201 && l.data.order <= 300);
const proLessons = lessons.filter(l => l.data.order >= 301);

const categoryColors: Record<string, { active: string; hover: string; bg: string; text: string; border: string; badge: string }> = {
  python: { active: 'bg-indigo-600', hover: 'hover:bg-indigo-50', bg: 'bg-indigo-50', text: 'text-indigo-700', border: 'border-indigo-200', badge: 'bg-indigo-100 text-indigo-700' },
  sql: { active: 'bg-blue-600', hover: 'hover:bg-blue-50', bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200', badge: 'bg-blue-100 text-blue-700' },
  excel: { active: 'bg-teal-600', hover: 'hover:bg-teal-50', bg: 'bg-teal-50', text: 'text-teal-700', border: 'border-teal-200', badge: 'bg-teal-100 text-teal-700' },
  eda: { active: 'bg-emerald-600', hover: 'hover:bg-emerald-50', bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200', badge: 'bg-emerald-100 text-emerald-700' },
  statistics: { active: 'bg-green-600', hover: 'hover:bg-green-50', bg: 'bg-green-50', text: 'text-green-700', border: 'border-green-200', badge: 'bg-green-100 text-green-700' },
  projects: { active: 'bg-violet-600', hover: 'hover:bg-violet-50', bg: 'bg-violet-50', text: 'text-violet-700', border: 'border-violet-200', badge: 'bg-violet-100 text-violet-700' },
};

const colors = categoryColors[category] || categoryColors.python;

const categoryNames: Record<string, string> = {
  python: 'Python',
  sql: 'SQL',
  excel: 'Excel',
  eda: 'EDA',
  statistics: 'Statistics',
  projects: 'Projects',
};

const catName = categoryNames[category] || category;

interface LessonGroup {
  label: string;
  tag: string;
  items: typeof lessons;
}

const groups: LessonGroup[] = [
  { label: '🟢 Basics', tag: 'Beginner', items: beginnerLessons },
  { label: '🟡 Intermediate', tag: 'Intermediate', items: intermediateLessons },
  { label: '🟠 Advanced', tag: 'Advanced', items: advancedLessons },
  { label: '🔴 Pro', tag: 'Pro', items: proLessons },
].filter(g => g.items.length > 0);
---

<nav class="topic-sidebar" aria-label={`${catName} lessons`}>
  <!-- Section header -->
  <div class="px-4 py-3 border-b border-slate-100">
    <a href={`/${category}/`} class="flex items-center gap-2 group">
      <span class:list={['inline-flex items-center justify-center w-7 h-7 rounded-lg text-white text-xs font-bold', colors.active]}>
        {catName.charAt(0)}
      </span>
      <span class="text-sm font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">{catName} Tutorial</span>
    </a>
    <p class="text-[11px] text-slate-400 mt-1 pl-9">{lessons.length} lessons · Basics → Pro</p>
  </div>

  <!-- Lesson groups -->
  <div class="overflow-y-auto max-h-[calc(100vh-12rem)] py-2 sidebar-scroll">
    {groups.map((group) => (
      <div class="mb-1">
        <div class="flex items-center gap-2 px-4 py-2">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">{group.label}</span>
          <span class:list={['text-[10px] font-bold px-1.5 py-0.5 rounded', colors.badge]}>{group.items.length}</span>
        </div>
        <ul class="space-y-0.5 px-2">
          {group.items.map((lesson) => {
            const slug = getSlug(lesson.id);
            const isActive = slug === currentSlug;
            return (
              <li>
                <a
                  href={`/${category}/${slug}/`}
                  class:list={[
                    'flex items-center gap-2 px-3 py-1.5 rounded-lg text-[13px] transition-all duration-150',
                    isActive
                      ? `${colors.active} text-white font-semibold shadow-sm`
                      : `text-slate-600 ${colors.hover} hover:text-slate-900`,
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class:list={[
                    'w-1.5 h-1.5 rounded-full shrink-0',
                    isActive ? 'bg-white' : 'bg-slate-300',
                  ]}></span>
                  <span class="truncate">{lesson.data.title.replace(/\s*—.*$/, '')}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</nav>

<style>
  .topic-sidebar {
    width: 100%;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .sidebar-scroll::-webkit-scrollbar {
    width: 4px;
  }

  .sidebar-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar-scroll::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 9999px;
  }

  .sidebar-scroll::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
</style>
