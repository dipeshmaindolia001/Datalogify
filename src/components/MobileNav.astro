---
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const learnPaths = ['/python/', '/python-libraries/', '/sql/', '/excel/', '/eda/', '/statistics/'];
const isLearnActive = learnPaths.some(path => currentPath.startsWith(path));
---

<div
  id="mobile-nav"
  class="fixed inset-0 z-[100] translate-x-full opacity-0 pointer-events-none transition-all duration-300 ease-in-out md:hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
>
  <!-- Backdrop -->
  <div
    id="mobile-nav-backdrop"
    class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"
  ></div>

  <!-- Panel -->
  <div class="absolute right-0 top-0 h-full w-full max-w-sm bg-white shadow-2xl flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
      <a href="/" class="flex items-center gap-2">
        <svg class="h-6 w-6 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="12" width="4" height="9" rx="1" fill="currentColor" opacity="0.3" />
          <rect x="10" y="7" width="4" height="14" rx="1" fill="currentColor" opacity="0.5" />
          <rect x="17" y="3" width="4" height="18" rx="1" fill="currentColor" opacity="0.8" />
        </svg>
        <span class="text-lg font-bold text-slate-800">Datalogify</span>
      </a>
      <button
        id="mobile-nav-close"
        class="flex items-center justify-center w-10 h-10 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-colors"
        aria-label="Close navigation menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Nav Links -->
    <nav class="flex-1 overflow-y-auto px-6 py-6" aria-label="Mobile navigation">
      <ul class="space-y-1">
        <!-- Home -->
        <li>
          <a
            href="/"
            class:list={[
              'flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200',
              isActive('/')
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-50',
            ]}
            aria-current={isActive('/') ? 'page' : undefined}
          >
            <span>Home</span>
          </a>
        </li>

        <!-- Roadmap -->
        <li>
          <a
            href="/roadmap/"
            class:list={[
              'flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200',
              isActive('/roadmap/')
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-50',
            ]}
            aria-current={isActive('/roadmap/') ? 'page' : undefined}
          >
            <span>Roadmap</span>
          </a>
        </li>

        <!-- Learn Collapsible Dropdown -->
        <li>
          <button 
            id="mobile-learn-btn"
            class:list={[
              'flex items-center justify-between w-full px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200 cursor-pointer',
              isLearnActive
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-50',
            ]}
          >
            <span>Learn</span>
            <svg id="mobile-learn-chevron" class="h-5 w-5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <ul id="mobile-learn-menu" class="hidden pl-6 mt-1 space-y-1 bg-slate-50/50 rounded-xl p-2 border border-slate-100">
            <li>
              <a href="/python/" class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:text-indigo-600 hover:bg-indigo-50/50 transition-colors">
                🐍 Python
              </a>
            </li>
            <li>
              <a href="/python-libraries/" class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:text-indigo-600 hover:bg-indigo-50/50 transition-colors">
                📚 Python Libraries
              </a>
            </li>
            <li>
              <a href="/sql/" class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:text-indigo-600 hover:bg-indigo-50/50 transition-colors">
                🗃️ SQL
              </a>
            </li>
            <li>
              <a href="/excel/" class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:text-indigo-600 hover:bg-indigo-50/50 transition-colors">
                📊 Excel
              </a>
            </li>
            <li>
              <a href="/eda/" class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:text-indigo-600 hover:bg-indigo-50/50 transition-colors">
                🔍 Data Analysis (EDA)
              </a>
            </li>
            <li>
              <a href="/statistics/" class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium text-slate-700 hover:text-indigo-600 hover:bg-indigo-50/50 transition-colors">
                📈 Statistics
              </a>
            </li>
            <li class="flex items-center justify-between px-4 py-3 rounded-lg text-sm font-medium text-slate-400 cursor-not-allowed">
              <span>📊 Power BI</span>
              <span class="text-[9px] font-bold uppercase tracking-wider text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Soon</span>
            </li>
            <li class="flex items-center justify-between px-4 py-3 rounded-lg text-sm font-medium text-slate-400 cursor-not-allowed">
              <span>🎨 Tableau</span>
              <span class="text-[9px] font-bold uppercase tracking-wider text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Soon</span>
            </li>
          </ul>
        </li>

        <!-- Projects -->
        <li>
          <a
            href="/projects/"
            class:list={[
              'flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200',
              isActive('/projects/')
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-50',
            ]}
            aria-current={isActive('/projects/') ? 'page' : undefined}
          >
            <span>Projects</span>
          </a>
        </li>

        <!-- Practice -->
        <li>
          <a
            href="/practice/"
            class:list={[
              'flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200',
              isActive('/practice/')
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-50',
            ]}
            aria-current={isActive('/practice/') ? 'page' : undefined}
          >
            <span>Practice</span>
          </a>
        </li>

        <!-- Interview Prep -->
        <li>
          <a
            href="/interview-prep/"
            class:list={[
              'flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200',
              isActive('/interview-prep/')
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-50',
            ]}
            aria-current={isActive('/interview-prep/') ? 'page' : undefined}
          >
            <span>Interview Prep</span>
          </a>
        </li>

        <!-- Blog -->
        <li>
          <a
            href="/blog/"
            class:list={[
              'flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200',
              isActive('/blog/')
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-50',
            ]}
            aria-current={isActive('/blog/') ? 'page' : undefined}
          >
            <span>Blog</span>
          </a>
        </li>

        <!-- About -->
        <li>
          <a
            href="/about/"
            class:list={[
              'flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium transition-all duration-200',
              isActive('/about/')
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-50',
            ]}
            aria-current={isActive('/about/') ? 'page' : undefined}
          >
            <span>About</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Footer -->
    <div class="px-6 py-5 border-t border-slate-100">
      <p class="text-xs text-slate-400 text-center">
        Built for aspiring data analysts ✨
      </p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const mobileNav = document.getElementById('mobile-nav');
    const closeBtn = document.getElementById('mobile-nav-close');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const learnBtn = document.getElementById('mobile-learn-btn');
    const learnMenu = document.getElementById('mobile-learn-menu');
    const learnChevron = document.getElementById('mobile-learn-chevron');

    function closeMobileNav() {
      if (!mobileNav) return;
      mobileNav.classList.add('translate-x-full', 'opacity-0', 'pointer-events-none');
      mobileNav.classList.remove('translate-x-0', 'opacity-100');
      mobileNav.setAttribute('aria-hidden', 'true');
      menuBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    function openMobileNav() {
      if (!mobileNav) return;
      mobileNav.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
      mobileNav.classList.add('translate-x-0', 'opacity-100');
      mobileNav.setAttribute('aria-hidden', 'false');
      menuBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    menuBtn?.addEventListener('click', openMobileNav);
    closeBtn?.addEventListener('click', closeMobileNav);
    backdrop?.addEventListener('click', closeMobileNav);

    if (learnBtn && learnMenu && learnChevron) {
      learnBtn.addEventListener('click', () => {
        const isHidden = learnMenu.classList.contains('hidden');
        if (isHidden) {
          learnMenu.classList.remove('hidden');
          learnChevron.classList.add('rotate-180');
        } else {
          learnMenu.classList.add('hidden');
          learnChevron.classList.remove('rotate-180');
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileNav();
    });
  });
</script>
