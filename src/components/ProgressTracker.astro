---
interface Props {
  currentPhase?: number;
  currentCategory?: string;
}

const { currentPhase = 1, currentCategory = '' } = Astro.props;

interface Phase {
  number: number;
  label: string;
  href: string;
}

const phases: Phase[] = [
  { number: 1, label: 'Python', href: '/python/' },
  { number: 2, label: 'SQL', href: '/sql/' },
  { number: 3, label: 'Excel', href: '/excel/' },
  { number: 4, label: 'EDA', href: '/eda/' },
  { number: 5, label: 'Statistics', href: '/statistics/' },
  { number: 6, label: 'Projects', href: '/projects/' },
  { number: 7, label: 'Interview Prep', href: '/interview-prep/' },
];

function getStatus(phaseNumber: number): 'completed' | 'current' | 'future' {
  if (phaseNumber < currentPhase) return 'completed';
  if (phaseNumber === currentPhase) return 'current';
  return 'future';
}
---

<aside class="rounded-xl border border-slate-200 bg-white p-5" aria-label="Learning progress">
  <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">
    Your Progress
  </h3>

  <ol class="space-y-1">
    {phases.map((phase) => {
      const status = getStatus(phase.number);
      return (
        <li>
          <a
            href={phase.href}
            class:list={[
              'flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200',
              status === 'current' && 'bg-indigo-50 text-indigo-700',
              status === 'completed' && 'text-slate-600 hover:bg-slate-50',
              status === 'future' && 'text-slate-400 hover:bg-slate-50 hover:text-slate-500',
            ]}
            aria-current={status === 'current' ? 'step' : undefined}
          >
            {/* Phase indicator */}
            <span
              class:list={[
                'flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold shrink-0 transition-colors',
                status === 'current' && 'bg-indigo-600 text-white shadow-sm shadow-indigo-200',
                status === 'completed' && 'bg-emerald-100 text-emerald-600',
                status === 'future' && 'bg-slate-100 text-slate-400',
              ]}
            >
              {status === 'completed' ? (
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              ) : (
                phase.number
              )}
            </span>

            <span class="truncate">{phase.label}</span>

            {status === 'current' && (
              <span class="ml-auto w-2 h-2 rounded-full bg-indigo-500 animate-pulse shrink-0" aria-hidden="true"></span>
            )}
          </a>
        </li>
      );
    })}
  </ol>
</aside>
