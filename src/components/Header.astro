---
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const learnPaths = ['/python/', '/sql/', '/excel/', '/eda/', '/statistics/'];
const isLearnActive = learnPaths.some(path => currentPath.startsWith(path));
---

<header
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-sm border-b border-slate-200"
  transition:persist
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-2xl" aria-hidden="true">
          <svg class="h-7 w-7 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="12" width="4" height="9" rx="1" fill="currentColor" opacity="0.3" />
            <rect x="10" y="7" width="4" height="14" rx="1" fill="currentColor" opacity="0.5" />
            <rect x="17" y="3" width="4" height="18" rx="1" fill="currentColor" opacity="0.8" />
          </svg>
        </span>
        <span class="text-xl font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">
          Datalogify
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        <!-- Home -->
        <a
          href="/"
          class:list={[
            'px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200',
            isActive('/')
              ? 'text-indigo-600 bg-indigo-50'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',
          ]}
          aria-current={isActive('/') ? 'page' : undefined}
        >
          Home
        </a>

        <!-- Roadmap -->
        <a
          href="/roadmap/"
          class:list={[
            'px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200',
            isActive('/roadmap/')
              ? 'text-indigo-600 bg-indigo-50'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',
          ]}
          aria-current={isActive('/roadmap/') ? 'page' : undefined}
        >
          Roadmap
        </a>

        <!-- Learn Dropdown -->
        <div class="relative group">
          <button
            class:list={[
              'inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200 cursor-pointer',
              isLearnActive
                ? 'text-indigo-600 bg-indigo-50'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',
            ]}
          >
            <span>Learn</span>
            <svg class="h-4 w-4 text-slate-400 group-hover:text-indigo-600 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown List -->
          <div class="absolute left-0 mt-1 w-56 origin-top-left rounded-xl border border-slate-200/60 bg-white p-2 shadow-lg ring-1 ring-black/5 hidden group-hover:block animate-fade-in z-50">
            <a
              href="/python/"
              class:list={[
                'flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-colors font-medium',
                isActive('/python/')
                  ? 'text-indigo-600 bg-indigo-50/50'
                  : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900',
              ]}
            >
              🐍 Python
            </a>
            <a
              href="/sql/"
              class:list={[
                'flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-colors font-medium',
                isActive('/sql/')
                  ? 'text-indigo-600 bg-indigo-50/50'
                  : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900',
              ]}
            >
              🗃️ SQL
            </a>
            <a
              href="/excel/"
              class:list={[
                'flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-colors font-medium',
                isActive('/excel/')
                  ? 'text-indigo-600 bg-indigo-50/50'
                  : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900',
              ]}
            >
              📊 Excel
            </a>
            <a
              href="/eda/"
              class:list={[
                'flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-colors font-medium',
                isActive('/eda/')
                  ? 'text-indigo-600 bg-indigo-50/50'
                  : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900',
              ]}
            >
              🔍 Data Analysis (EDA)
            </a>
            <a
              href="/statistics/"
              class:list={[
                'flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm transition-colors font-medium',
                isActive('/statistics/')
                  ? 'text-indigo-600 bg-indigo-50/50'
                  : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900',
              ]}
            >
              📈 Statistics
            </a>
            <div class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-slate-400 cursor-not-allowed">
              <span>📊 Power BI</span>
              <span class="text-[9px] font-bold uppercase tracking-wider text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Soon</span>
            </div>
            <div class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-slate-400 cursor-not-allowed">
              <span>🎨 Tableau</span>
              <span class="text-[9px] font-bold uppercase tracking-wider text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Soon</span>
            </div>
          </div>
        </div>

        <!-- Projects -->
        <a
          href="/projects/"
          class:list={[
            'px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200',
            isActive('/projects/')
              ? 'text-indigo-600 bg-indigo-50'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',
          ]}
          aria-current={isActive('/projects/') ? 'page' : undefined}
        >
          Projects
        </a>

        <!-- Interview Prep -->
        <a
          href="/interview-prep/"
          class:list={[
            'px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200',
            isActive('/interview-prep/')
              ? 'text-indigo-600 bg-indigo-50'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',
          ]}
          aria-current={isActive('/interview-prep/') ? 'page' : undefined}
        >
          Interview Prep
        </a>

        <!-- Blog -->
        <a
          href="/blog/"
          class:list={[
            'px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200',
            isActive('/blog/')
              ? 'text-indigo-600 bg-indigo-50'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',
          ]}
          aria-current={isActive('/blog/') ? 'page' : undefined}
        >
          Blog
        </a>

        <!-- About -->
        <a
          href="/about/"
          class:list={[
            'px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200',
            isActive('/about/')
              ? 'text-indigo-600 bg-indigo-50'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50',
          ]}
          aria-current={isActive('/about/') ? 'page' : undefined}
        >
          About
        </a>
      </nav>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    if (btn && mobileNav) {
      btn.addEventListener('click', () => {
        mobileNav.classList.remove('translate-x-full', 'opacity-0', 'pointer-events-none');
        mobileNav.classList.add('translate-x-0', 'opacity-100');
        btn.setAttribute('aria-expanded', 'true');
      });
    }
  });
</script>
