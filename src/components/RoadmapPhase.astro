---
interface Props {
  number: number;
  title: string;
  description: string;
  topics: string[];
  duration: string;
  status: 'current' | 'upcoming' | 'completed';
  link: string;
}

const { number, title, description, topics, duration, status, link } = Astro.props;

const statusStyles = {
  current: {
    card: 'border-indigo-200 bg-white shadow-lg shadow-indigo-100/50 ring-1 ring-indigo-100',
    circle: 'bg-indigo-600 text-white shadow-lg shadow-indigo-300/50',
    title: 'text-indigo-900',
    description: 'text-slate-600',
    pill: 'bg-indigo-100 text-indigo-700',
    badge: 'bg-indigo-100 text-indigo-700',
    linkBtn: 'bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm',
  },
  completed: {
    card: 'border-emerald-200 bg-emerald-50/30',
    circle: 'bg-emerald-500 text-white',
    title: 'text-emerald-900',
    description: 'text-emerald-700/70',
    pill: 'bg-emerald-100 text-emerald-700',
    badge: 'bg-emerald-100 text-emerald-700',
    linkBtn: 'bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm',
  },
  upcoming: {
    card: 'border-slate-200 bg-slate-50/50',
    circle: 'bg-slate-200 text-slate-500',
    title: 'text-slate-700',
    description: 'text-slate-500',
    pill: 'bg-slate-100 text-slate-500',
    badge: 'bg-slate-100 text-slate-500',
    linkBtn: 'bg-slate-200 text-slate-500 cursor-not-allowed',
  },
};

const s = statusStyles[status];
---

<article class:list={[
  'relative rounded-xl border p-6 sm:p-8 transition-all duration-300',
  s.card,
  status === 'current' && 'hover:shadow-xl hover:shadow-indigo-100/50',
  status !== 'upcoming' && 'hover:scale-[1.01]',
]}>
  <div class="flex flex-col sm:flex-row gap-5">
    <!-- Phase Number Circle -->
    <div class="shrink-0">
      <div class:list={[
        'flex items-center justify-center w-12 h-12 rounded-full text-lg font-bold',
        s.circle,
      ]}>
        {status === 'completed' ? (
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        ) : (
          number
        )}
      </div>
    </div>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <h3 class:list={['text-lg font-bold', s.title]}>
          Phase {number}: {title}
        </h3>

        <!-- Duration Badge -->
        <span class:list={[
          'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold',
          s.badge,
        ]}>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          {duration}
        </span>

        {/* Status label for current */}
        {status === 'current' && (
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-600 text-white">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
            In Progress
          </span>
        )}
        {status === 'completed' && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
            Completed
          </span>
        )}
      </div>

      <p class:list={['text-sm leading-relaxed mb-4', s.description]}>
        {description}
      </p>

      <!-- Topic Pills -->
      <div class="flex flex-wrap gap-2 mb-5">
        {topics.map((topic) => (
          <span class:list={[
            'inline-block px-3 py-1 rounded-full text-xs font-medium',
            s.pill,
          ]}>
            {topic}
          </span>
        ))}
      </div>

      <!-- Action Link -->
      {status !== 'upcoming' ? (
        <a
          href={link}
          class:list={[
            'inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200',
            s.linkBtn,
          ]}
        >
          {status === 'completed' ? 'Review' : 'Start Learning'}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ) : (
        <span class:list={[
          'inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold',
          s.linkBtn,
        ]}>
          Coming Soon
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </span>
      )}
    </div>
  </div>
</article>
